# PACHELBEL CANON - the one song here that is not original, because it does not need to be.
# The format is in Demo1/CLAUDE.md, under "Song files". Instruments are tables with
# one entry per frame; each channel holds named tracks of sixteen rows; the lines at the
# end are the order list. In a track '.' holds and '-' releases. '#' starts a comment.
#
# Johann Pachelbel's Canon, for three violins and continuo, written around 1700 by a
# composer who died in 1706: public domain. The notes are meant to be the original's, not
# any modern arrangement's - an arrangement can carry its own copyright even when the piece
# does not, which is why no edition was copied into this file. They were written out from
# the piece itself, not checked against a score, so a wrong note is possible; every one of
# them was checked against the chord its bass note makes, which is where a slip would show.
#
# How it is built is the whole point of putting it on four channels. The continuo plays
# the same eight notes for the entire piece - the ground - and three violins play one
# line, each entering two bars after the last, so every statement of the line sounds
# against the one before it and the one before that. Channel 2 leads, 3 follows it by one
# ground, 4 by two. Their tracks are the same text three times; that repetition is the canon.
#
# Abridged: six of the line's statements, where the original has many more - the quarter
# notes, the quarter notes descending, the arpeggios in eighths, the sixteenths with the
# octave leaps, and the two famous running statements - then the opening again as the
# voices close. The rows are 32nd notes, so the fastest passage gets one row a note.
#
# In A major, not D: the bass is on distortion C, and in D its B and G miss by 26 and 19
# cents. In A every ground note - A E F# C# D - lands within 14, and the violins fall a
# fourth into octaves 3 and 4, the pure-tone table's best. The ground's first leap goes up
# a fifth instead of down a fourth, because A2 is the bass table's worst note.

song   PACHELBEL CANON
key    A MAJOR
rows   16
beat   8

# The continuo: a bowed bass, not plucked - it holds each note for its whole beat.
instrument CONTINUO
  table      buzz
  volume     12 12 11 11 10 10 10 9 9 9 9 8
  distortion buzz
  release    2

# All three violins are one instrument, as in the original: the canon is heard as one
# line chasing itself, and a different sound on each would make three tunes of it.
# Vibrato waits ten frames, so it sings on the quarter notes and leaves the runs alone.
instrument VIOLIN
  table      tone
  volume     9 11 11 11 10 10 10 10 9
  distortion tone
  #vibrato    0 1 1 0 -1 -1
  #vibrato    0 0 0 1 1 1 0 0 0 -1 -1 -1
  #delay      10
  #delay      20
  release    2

channel 1 notes CONTINUO
  note  The ground: A E F# C# D A D E, a beat each, from the first bar to the last - the
  note  chords I V vi iii IV I IV V. Each track is two beats, so four make the ground.
  voice CONTINUO
  track G1  A1 . . . . . . .  E2 . . . . . . .
  track G2  F#2 . . . . . . .  C#2 . . . . . . .
  track G3  D2 . . . . . . .  A1 . . . . . . .
  track G4  D2 . . . . . . .  E2 . . . . . . .
  track FIN A1 . . . . . . .  . . . . . . . .

channel 2 notes VIOLIN 1
  note  The leader. It plays each statement first, one ground after the bass begins;
  note  violins 2 and 3 play exactly these tracks, one and two grounds behind.
  voice VIOLIN
  track S1a C#5 . . . . . . .  B4 . . . . . . .
  track S1b A4 . . . . . . .  G#4 . . . . . . .
  track S1c F#4 . . . . . . .  E4 . . . . . . .
  track S1d F#4 . . . . . . .  G#4 . . . . . . .
  track S2a A4 . . . . . . .  G#4 . . . . . . .
  track S2b F#4 . . . . . . .  E4 . . . . . . .
  track S2c D4 . . . . . . .  C#4 . . . . . . .
  track S2d D4 . . . . . . .  B3 . . . . . . .
  track S3a A3 . . .  C#4 . . .  E4 . . .  D4 . . .
  track S3b C#4 . . .  A3 . . .  C#4 . . .  B3 . . .
  track S3c A3 . . .  F#3 . . .  A3 . . .  E4 . . .
  track S3d D4 . . .  F#4 . . .  E4 . . .  D4 . . .
  track S4a A4 . G#4 .  A4 . A3 .  G#3 . E4 .  B3 . C#4 .
  track S4b A3 . A4 .  G#4 . F#4 .  G#4 . C#5 .  E5 . F#5 .
  track S4c D5 . C#5 .  B4 . D5 .  C#5 . B4 .  A4 . G#4 .
  track S4d F#4 . E4 .  D4 . C#4 .  B3 . D4 .  C#4 . B3 .
  track S5a C#5 . A4 B4  C#5 . A4 B4  C#5 E4 F#4 G#4  A4 B4 C#5 D5
  track S5b C#5 . A4 B4  C#5 . C#4 D4  E4 F#4 E4 D4  E4 C#4 D4 E4
  track S5c D4 . F#4 E4  D4 . C#4 B3  C#4 B3 A3 B3  C#4 D4 E4 F#4
  track S5d D4 . F#4 E4  F#4 . G#4 A4  E4 F#4 G#4 A4  B4 C#5 D5 E5
  track S6a C#5 . A4 B4  C#5 . B4 A4  B4 G#4 A4 B4  C#5 B4 A4 G#4
  track S6b A4 . F#4 G#4  A4 . A3 B3  C#4 D4 C#4 B3  C#4 A4 G#4 A4
  track S6c F#4 . A4 G#4  F#4 . E4 D4  E4 D4 C#4 D4  E4 F#4 G#4 A4
  track S6d F#4 . A4 G#4  A4 . G#4 F#4  G#4 A4 B4 A4  G#4 A4 F#4 G#4
  track FIN A4 . . . . . . .  . . . . . . . .

channel 3 notes VIOLIN 2
  note  The same line, one ground later.
  voice VIOLIN
  track S1a C#5 . . . . . . .  B4 . . . . . . .
  track S1b A4 . . . . . . .  G#4 . . . . . . .
  track S1c F#4 . . . . . . .  E4 . . . . . . .
  track S1d F#4 . . . . . . .  G#4 . . . . . . .
  track S2a A4 . . . . . . .  G#4 . . . . . . .
  track S2b F#4 . . . . . . .  E4 . . . . . . .
  track S2c D4 . . . . . . .  C#4 . . . . . . .
  track S2d D4 . . . . . . .  B3 . . . . . . .
  track S3a A3 . . .  C#4 . . .  E4 . . .  D4 . . .
  track S3b C#4 . . .  A3 . . .  C#4 . . .  B3 . . .
  track S3c A3 . . .  F#3 . . .  A3 . . .  E4 . . .
  track S3d D4 . . .  F#4 . . .  E4 . . .  D4 . . .
  track S4a A4 . G#4 .  A4 . A3 .  G#3 . E4 .  B3 . C#4 .
  track S4b A3 . A4 .  G#4 . F#4 .  G#4 . C#5 .  E5 . F#5 .
  track S4c D5 . C#5 .  B4 . D5 .  C#5 . B4 .  A4 . G#4 .
  track S4d F#4 . E4 .  D4 . C#4 .  B3 . D4 .  C#4 . B3 .
  track S5a C#5 . A4 B4  C#5 . A4 B4  C#5 E4 F#4 G#4  A4 B4 C#5 D5
  track S5b C#5 . A4 B4  C#5 . C#4 D4  E4 F#4 E4 D4  E4 C#4 D4 E4
  track S5c D4 . F#4 E4  D4 . C#4 B3  C#4 B3 A3 B3  C#4 D4 E4 F#4
  track S5d D4 . F#4 E4  F#4 . G#4 A4  E4 F#4 G#4 A4  B4 C#5 D5 E5
  track S6a C#5 . A4 B4  C#5 . B4 A4  B4 G#4 A4 B4  C#5 B4 A4 G#4
  track S6b A4 . F#4 G#4  A4 . A3 B3  C#4 D4 C#4 B3  C#4 A4 G#4 A4
  track S6c F#4 . A4 G#4  F#4 . E4 D4  E4 D4 C#4 D4  E4 F#4 G#4 A4
  track S6d F#4 . A4 G#4  A4 . G#4 F#4  G#4 A4 B4 A4  G#4 A4 F#4 G#4
  track FIN E4 . . . . . . .  . . . . . . . .

channel 4 notes VIOLIN 3
  note  The same line again, two grounds behind the leader. Three statements at once are
  note  what the canon sounds like, and none of them was written as an accompaniment.
  voice VIOLIN
  track S1a C#5 . . . . . . .  B4 . . . . . . .
  track S1b A4 . . . . . . .  G#4 . . . . . . .
  track S1c F#4 . . . . . . .  E4 . . . . . . .
  track S1d F#4 . . . . . . .  G#4 . . . . . . .
  track S2a A4 . . . . . . .  G#4 . . . . . . .
  track S2b F#4 . . . . . . .  E4 . . . . . . .
  track S2c D4 . . . . . . .  C#4 . . . . . . .
  track S2d D4 . . . . . . .  B3 . . . . . . .
  track S3a A3 . . .  C#4 . . .  E4 . . .  D4 . . .
  track S3b C#4 . . .  A3 . . .  C#4 . . .  B3 . . .
  track S3c A3 . . .  F#3 . . .  A3 . . .  E4 . . .
  track S3d D4 . . .  F#4 . . .  E4 . . .  D4 . . .
  track S4a A4 . G#4 .  A4 . A3 .  G#3 . E4 .  B3 . C#4 .
  track S4b A3 . A4 .  G#4 . F#4 .  G#4 . C#5 .  E5 . F#5 .
  track S4c D5 . C#5 .  B4 . D5 .  C#5 . B4 .  A4 . G#4 .
  track S4d F#4 . E4 .  D4 . C#4 .  B3 . D4 .  C#4 . B3 .
  track S5a C#5 . A4 B4  C#5 . A4 B4  C#5 E4 F#4 G#4  A4 B4 C#5 D5
  track S5b C#5 . A4 B4  C#5 . C#4 D4  E4 F#4 E4 D4  E4 C#4 D4 E4
  track S5c D4 . F#4 E4  D4 . C#4 B3  C#4 B3 A3 B3  C#4 D4 E4 F#4
  track S5d D4 . F#4 E4  F#4 . G#4 A4  E4 F#4 G#4 A4  B4 C#5 D5 E5
  track S6a C#5 . A4 B4  C#5 . B4 A4  B4 G#4 A4 B4  C#5 B4 A4 G#4
  track S6b A4 . F#4 G#4  A4 . A3 B3  C#4 D4 C#4 B3  C#4 A4 G#4 A4
  track S6c F#4 . A4 G#4  F#4 . E4 D4  E4 D4 C#4 D4  E4 F#4 G#4 A4
  track S6d F#4 . A4 G#4  A4 . G#4 F#4  G#4 A4 B4 A4  G#4 A4 F#4 G#4
  track FIN C#4 . . . . . . .  . . . . . . . .

# The order list: a line is two beats, so four lines are one ground.
# Continuo, violins 1, 2 and 3.
speed  9
audctl $00
section GROUND
line   G1   .    .    .
line   G2   .    .    .
line   G3   .    .    .
line   G4   .    .    .
section ONE VIOLIN
line   G1   S1a  .    .
line   G2   S1b  .    .
line   G3   S1c  .    .
line   G4   S1d  .    .
section TWO VIOLINS
line   G1   S2a  S1a  .
line   G2   S2b  S1b  .
line   G3   S2c  S1c  .
line   G4   S2d  S1d  .
section CANON
line   G1   S3a  S2a  S1a
line   G2   S3b  S2b  S1b
line   G3   S3c  S2c  S1c
line   G4   S3d  S2d  S1d
line   G1   S4a  S3a  S2a
line   G2   S4b  S3b  S2b
line   G3   S4c  S3c  S2c
line   G4   S4d  S3d  S2d
section RUNNING
line   G1   S5a  S4a  S3a
line   G2   S5b  S4b  S3b
line   G3   S5c  S4c  S3c
line   G4   S5d  S4d  S3d
line   G1   S6a  S5a  S4a
line   G2   S6b  S5b  S4b
line   G3   S6c  S5c  S4c
line   G4   S6d  S5d  S4d
section CLOSING
line   G1   S1a  S6a  S5a
line   G2   S1b  S6b  S5b
line   G3   S1c  S6c  S5c
line   G4   S1d  S6d  S5d
line   G1   S2a  S1a  S6a
line   G2   S2b  S1b  S6b
line   G3   S2c  S1c  S6c
line   G4   S2d  S1d  S6d
line   FIN  FIN  FIN  FIN
end
