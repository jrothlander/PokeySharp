  track ME1   @BASS_FF E2 . - .  - . . .
  track MEEE  @BASS_FF E2 . E2 .  E2 . - .
  track N16   C#3 . - .  F#2 . - .
  track N17   C#2 . - .  - . C#2 .
  track N18   G#2 . - .  - . G#1 .
