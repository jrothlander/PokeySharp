  track G7    @TUTTI F#4 G#4 F#4 G#4  F#4 G#4 F#4 G#4
  track G8    @TUTTI F#4 G#4 F#4 D#4  B3 B4 C#5 D#5
  track G7B   @TUTTI F#4 G#4 F#4 G#4  F#4 A4 G#4 F#4
  track G8B   @TUTTI E5 . - .  C#5 . . .
  track G8C   @TUTTI E4 . B3 .  E4 . G#4 G#4
  track N16   @DOLCE . B#4 C#5 B#4  D#5 C#5 B4 A4
  track N17   @DOLCE A4 G#4 E4 C#4  C#4 C#4 C#4 C#4
  track N18   @DOLCE E4 D#4 B#3 G#3  G#3 G#3 G#3 G#3
  track N19   @DOLCE G#3 C#4 E4 G#4  C#5 C#5 C#5 C#5
  track N20   @DOLCE C#5 B#4 C#5 B#4  D#5 C#5 B4 A4
  track N21   @DOLCE G#4 E4 C#4 C#4  C#4 C#4 C#4 C#4
  track N23   @DOLCE G#3 C#4 E4 G#4  C#5 E5 D#5 C#5
  track N24   @DOLCE D#5 B#4 G#4 G#4  G#4 G#5 E5 C#5
  track N26   @DOLCE D#5 B4 G#4 G#4  A#4 G4 D#4 D#4
