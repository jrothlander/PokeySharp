  track N34   @DOLCE F#4 G#4 F#4 G#4  F#4 G#4 F#4 G#4
  track N35   @DOLCE F#4 G#4 F#4 D#4  B3 B#3 C#4 D#4
  track N42   @DOLCE F#4 C#5 B#4 C#5  D#5 C#5 A4 F#4
  track N43   @TUTTI E4 E4 F#4 G#4  A4 B4 C#5 D#5
  track T8    E4 . G#4 .  E4 . B4 B4
  track T1    @TUTTI B4 . B4 B4  B4 . B4 B4
