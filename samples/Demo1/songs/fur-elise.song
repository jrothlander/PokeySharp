# FUR ELISE - Beethoven, Bagatelle in A minor, WoO 59 (1810, published 1867).
# The format is in Demo1/CLAUDE.md, under "Song files". Instruments are tables with
# one entry per frame; each channel holds named tracks; the lines at the end are the
# order list. In a track '.' holds and '-' releases. '#' starts a comment.
#
# Public domain: Beethoven died in 1827. The A section is written from the melody everyone
# knows, not read off a score; the bridge back from the C major episode is shortened to two
# bars of the E - D sharp figure, which runs straight into the theme again.
#
# A row is a sixteenth and a line is a bar of 3/8 - six rows, a beat of a dotted quarter at
# 60 a minute, Beethoven's "poco moto". The piece is one line of sixteenths passed between
# the hands, and the two hands are kept apart here as they are on the keyboard: the left's
# arpeggio on channel 2, the right's tune on channel 4.
#
# Both hands are 16-bit. AUDCTL 78 joins channels 1 and 2, and 3 and 4, on the fast clock,
# so every note is within two cents at the pitch Beethoven wrote - the 8-bit table would have
# the tune's E and D sharp fifteen cents apart from where they should be, and in a piece that
# turns on those two notes, that is the piece out of tune. It costs all four channels, which
# is what a piano solo needs.

song   FUR ELISE
key    A MINOR
rows   6
beat   6

# A piano, of a kind: struck, falling away, and holding quietly.
instrument PIANO_R
  table      wide
  volume     13 12 11 10 10 9 9 8 8 7 7 6 6 5 5 5 4 4 4 3
  distortion tone
  release    3

instrument PIANO_L
  table      wide
  volume     10 9 9 8 8 7 7 6 6 5 5 4 4 4 3 3 3 2
  distortion tone
  release    3

channel 1 pair LOW BYTE L
  note  The low byte of the left hand's 16-bit divider.

channel 2 notes LEFT HAND
  note  The broken chords under the tune: A E A, E E G#, and C G C and G G B in the episode.
  voice PIANO_L
  track LA  A2 E3 A3 . . .
  track LE  E2 E3 G#3 . . .
  track LC  C3 G3 C4 . . .
  track LG  G2 G3 B3 . . .
  track LE2 E2 E3 E4 . . .

channel 3 pair LOW BYTE R
  note  The low byte of the right hand's 16-bit divider.

channel 4 notes RIGHT HAND
  note  E D# E B D C A - and the answers, C E A B, E G# B C.
  voice PIANO_R
  track R0  . . . . E5 D#5
  track R1  E5 D#5 E5 B4 D5 C5
  track R2  A4 . - C4 E4 A4
  track R3  B4 . - E4 G#4 B4
  track R4  C5 . - E4 E5 D#5
  track R7  B4 . - E4 C5 B4
  track R8  A4 . . - E5 D#5
  track R9  A4 . - B4 C5 D5
  track R10 E5 . . G4 F5 E5
  track R11 D5 . . F4 E5 D5
  track R12 C5 . . E4 D5 C5
  track R13 B4 . - E4 E5 E6
  track R14 E5 D#5 E5 D#5 E5 D#5

# The order list: a line is a bar of 3/8. Low byte, left hand, low byte, right hand.
speed  10
audctl $78
section PICKUP
line   .       .       .       R0
loop
section THEME
line   .       .       .       R1
line   .       LA      .       R2
line   .       LE      .       R3
line   .       LA      .       R4
line   .       .       .       R1
line   .       LA      .       R2
line   .       LE      .       R7
line   .       LA      .       R8
section THEME AGAIN
line   .       .       .       R1
line   .       LA      .       R2
line   .       LE      .       R3
line   .       LA      .       R4
line   .       .       .       R1
line   .       LA      .       R2
line   .       LE      .       R7
section EPISODE
line   .       LA      .       R9
line   .       LC      .       R10
line   .       LG      .       R11
line   .       LA      .       R12
line   .       LE2     .       R13
line   .       .       .       R14
line   .       .       .       R14
