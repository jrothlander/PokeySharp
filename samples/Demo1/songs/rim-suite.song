# RIM SUITE - a song for Demo1's song page and tools/soundexport.
# The format is in Demo1/CLAUDE.md, under "Song files". Instruments are tables with
# one entry per frame; each channel holds named tracks of sixteen rows; the lines at the
# end are the order list. In a track '.' holds and '-' releases. '#' starts a comment.

song   RIM SUITE
key    FIVE SECTIONS

# A click of tone, then the buzz table's divider climbing 20 to 80 - a pitch falling from
# 200 Hz to 50, as close to a thump as one channel gets.
instrument KICK
  table      none
  volume     15 14 13 11 9 7 5 3 1 0
  distortion tone buzz
  audf       40 20 27 34 43 52 62 71 80
  release    2

# One frame of tone for the crack, then the 17-bit poly for the rattle, darkening as it decays.
instrument SNARE
  table      none
  volume     14 13 11 9 7 6 5 4 3 2 1 0
  distortion tone noise
  audf       50 6 7 8 9 10 11 12 13
  release    2

# The poly at divider 0, the brightest noise the chip has, for four frames.
instrument HAT
  table      none
  volume     7 4 2 1 0
  distortion noise
  audf       0
  release    2

instrument OPEN
  table      none
  volume     7 6 5 5 4 4 3 3 2 2 1 1 0
  distortion noise
  audf       0
  release    2

# A slow attack - the volume climbs over five frames - which is the whole difference between
# a sung line and a struck one.
instrument VOICE
  table      tone
  volume     4 6 8 9 10 10 10 9 9 9 8
  distortion tone
  vibrato    0 1 1 0 -1 -1
  delay      20
  release    1

# Loud, sustained, and a vibrato that arrives early: the lead of the solo.
instrument GUITAR
  table      tone
  volume     14 13 12 11 11 10
  distortion tone
  vibrato    0 1 1 0 -1 -1
  delay      10
  release    2

instrument PLUCK
  table      tone
  volume     13 11 10 9 8 8 7 7 6
  distortion tone
  vibrato    0 1 1 0 -1 -1
  delay      14
  release    1

# As loud as a channel goes, and it stays there.
instrument POWER
  table      tone
  volume     15 14 13 12 12 11
  distortion tone
  release    3

# Struck and left to ring. Under a broken chord the notes overlap in the ear, though the
# channel only ever holds one.
instrument PIANO
  table      tone
  volume     10 9 8 7 6 6 5 5 4 4 3
  distortion tone
  release    1

# The guitar's notes, one divider step flat for their whole length: a one-entry vibrato table
# is a constant detune. Two channels a few hertz apart beat against each other, and the ear
# hears one thicker sound rather than two thin ones.
instrument DOUBLE
  table      tone
  volume     11 10 9 9 8
  distortion tone
  vibrato    1
  delay      0
  release    2

instrument CHOIR
  table      tone
  volume     10 9 9 8 8 7
  distortion tone
  release    1

instrument ARPEGGIO
  table      tone
  volume     8 7 6 6 5 5 5 4
  distortion tone
  release    1

# Distortion C, quietly, for the ballad and the coda.
instrument SOFT_BASS
  table      buzz
  volume     9 9 8 8 7
  distortion buzz
  release    2

instrument BASS
  table      buzz
  volume     13 12 11 10 10 9
  distortion buzz
  release    3

# The 16-bit table: channels 3 and 4 joined on the 1.79 MHz clock, every note within a cent.
# It plays only on lines whose AUDCTL joins them - the heavy section, where audctl is $28.
instrument WIDE_BASS
  table      wide
  volume     13 12 11 10 9 9 8
  distortion tone
  release    3

channel 1 drums DRUMS
  note  Sits out the ballad entirely: a silent channel costs nothing, and holding the
  note  drums back makes their entrance in the solo the biggest event in the piece. In the
  note  choir the kick plays timpani, which is only a kick left on its own.
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track SOLO     K . H .  S . H .  K . K H  S . H .
  track SOLOFILL K . H .  S . H .  S . S S  S S S S
  track TIMP     K . . .  . . . .  K . . .  . . . .
  track ROLL     K . . .  K . . .  K . K .  K K K K
  track HEAVY    K . H K  S . H .  K K H .  S . H H
  track HFILL    K . S .  K . S .  S S S S  S S O .
  track HIT      K . . .  . . . .  . . . .  . . . .

channel 2 notes LEAD
  note  The one channel that keeps its job and changes its sound: a slow-attack voice in
  note  the ballad and coda, a guitar in the solo, the choir's high and low answers, a
  note  flat-out tone in the heavy section. Each is a different table, named by the track
  note  - the driver itself never changes.
  voice VOICE
  track B1 - . . .  A4 . . .  D5 . . .  E5 . F5 .
  track B2 F5 . . .  . . . .  D5 . C5 .  A#4 . . .
  track B3 - . . .  G4 . A#4 .  D5 . . .  C5 . A#4 .
  track B4 A4 . . .  . . . .  C#5 . . .  E5 . . .
  track B5 F5 . . .  . . E5 .  D5 . . .  A4 . . .
  track B6 C5 . . .  . . . .  A4 . C5 .  F5 . . .
  track B7 D5 . . .  . . C5 .  A#4 . A4 .  G4 . . .
  track B8 A4 . . .  . . . .  . . . .  - . . .
  track S1 @GUITAR D5 . F5 .  A5 . . .  G5 F5 E5 F5  D5 . . .
  track S2 @GUITAR F5 . . .  D5 . F5 .  A#5 . A5 .  F5 . D5 .
  track S3 @GUITAR G5 . . .  . . A#5 .  A5 . G5 .  F5 . G5 .
  track S4 @GUITAR E5 . C#5 .  A4 . C#5 .  E5 . G5 .  A5 . . .
  track C1 @PLUCK A5 . A5 .  F5 . . .  C4 . C4 .  F4 . . .
  track C2 @PLUCK A5 . A5 .  E5 . . .  C#4 . C#4 .  E4 . . .
  track C3 @PLUCK F5 . F5 .  D5 . . .  A3 . A3 .  D4 . . .
  track C4 @PLUCK F5 . F5 .  A#5 . . .  F4 . F4 .  D4 . . .
  track C5 @PLUCK G5 . G5 .  A#5 . A5 .  G4 . G4 .  A#4 . A4 .
  track C6 @PLUCK E5 . . .  . . . .  A5 . . .  - . . .
  track H1 @POWER E4 . E4 E5  . E4 G4 .  A4 . E4 .  D5 . B4 .
  track H2 @POWER B4 . . .  A4 . G4 .  E4 . . .  G4 . A4 .
  track H3 @POWER C5 . . .  B4 . G4 .  E4 . G4 .  C5 . E5 .
  track H4 @POWER D5 . . .  F#5 . . .  D#5 . . .  B4 . . .
  track H5 @POWER E5 . . .  . . . .  - . . .  . . . .
  track E2 D5 . . .  . . . .  A#4 . . .  A4 . . .
  track E3 C#5 . . .  . . . .  E5 . . .  . . . .
  track E4 D5 . . .  . . . .  . . . .  - . . .

channel 3 notes HARMONY
  note  Harmony, and the channel that gets given away. Broken chords in the ballad; the
  note  guitar's notes one divider flat in the solo, where the beating between the two is
  note  the chorus; the choir's arpeggio. Then AUDCTL 28 makes it the bass's low byte for
  note  the heavy section, and it is silent until the coda hands it back.
  voice PIANO
  track DM  D3 . A3 .  F3 . A3 .  D3 . A3 .  F3 . A3 .
  track BB  D3 . F3 .  A#3 . F3 .  D3 . F3 .  A#3 . F3 .
  track GM  D3 . G3 .  A#3 . G3 .  D3 . G3 .  A#3 . G3 .
  track A   C#3 . E3 .  A3 . E3 .  C#3 . E3 .  A3 . E3 .
  track F   C3 . F3 .  A3 . F3 .  C3 . F3 .  A3 . F3 .
  track S1  @DOUBLE D5 . F5 .  A5 . . .  G5 F5 E5 F5  D5 . . .
  track S2  @DOUBLE F5 . . .  D5 . F5 .  A#5 . A5 .  F5 . D5 .
  track S3  @DOUBLE G5 . . .  . . A#5 .  A5 . G5 .  F5 . G5 .
  track S4  @DOUBLE E5 . C#5 .  A4 . C#5 .  E5 . G5 .  A5 . . .
  track CF  @CHOIR F . . .  F . . .  F . . .  F . . .
  track CA  @CHOIR A . . .  A . . .  A . . .  A . . .
  track CDM @CHOIR Dm . . .  Dm . . .  Dm . . .  Dm . . .
  track CBB @CHOIR A# . . .  A# . . .  A# . . .  A# . . .
  track CGM @CHOIR Gm . . .  Gm . . .  Gm . . .  Gm . . .
  track END @ARPEGGIO Dm . . .  . . . .  . . . .  - . . .

channel 4 notes BASS
  note  Distortion C through the ballad, solo and choir, all in keys chosen around its
  note  gaps. Then the heavy section joins it to channel 3 as a 16-bit counter and the
  note  riff moves to E minor - a key the buzz table cannot play, with no usable B.
  voice SOFT_BASS
  track BDM  D2 . . .  . . . .  . . . .  A1 . . .
  track BBB  A#1 . . .  . . . .  . . . .  . . . .
  track BGM  A#1 . . .  . . . .  . . . .  D2 . . .
  track BA   A1 . . .  . . . .  . . . .  C#2 . . .
  track BF   F2 . . .  . . . .  . . . .  . . . .
  track BEND D2 . . .  . . . .  . . . .  - . . .
  track SDM  @BASS D2 . D2 .  D2 . D2 .  D2 . D2 .  A1 . A1 .
  track SBB  @BASS A#1 . A#1 .  A#1 . A#1 .  A#1 . A#1 .  F2 . F2 .
  track SGM  @BASS A#1 . A#1 .  A#1 . A#1 .  D2 . D2 .  A#1 . A#1 .
  track SA   @BASS A1 . A1 .  A1 . A1 .  E2 . E2 .  C#2 . C#2 .
  track CF   @BASS F1 . . .  F2 . . .  F1 . . .  F2 . . .
  track CA   @BASS A1 . . .  E2 . . .  A1 . . .  E2 . . .
  track CDM  @BASS D2 . . .  A1 . . .  D2 . . .  A1 . . .
  track CBB  @BASS A#1 . . .  F2 . . .  A#1 . . .  F2 . . .
  track CGM  @BASS A#1 . . .  D2 . . .  A#1 . . .  D2 . . .
  track CA2  @BASS A1 . . .  . . . .  E2 . . .  C#2 . . .
  track R1   @WIDE_BASS E2 . E2 E3  . E2 G2 .  A2 . E2 .  D3 . B2 .
  track R2   @WIDE_BASS E2 . E2 E3  . E2 G2 .  A2 . A#2 B2  D3 . B2 .
  track R3   @WIDE_BASS C2 . C2 C3  . C2 E2 .  G2 . C3 .  B2 . G2 .
  track R4   @WIDE_BASS D2 . D2 D3  . D2 F#2 .  B1 . B1 B2  . B1 D#2 .
  track R5   @WIDE_BASS E2 . . .  . . . .  - . . .  . . . .

# The order list: one line per bar, a track per channel, '.' for none.
loop
section BALLAD
speed  10
audctl $00
line   .      B1     DM     BDM
line   .      B2     BB     BBB
line   .      B3     GM     BGM
line   .      B4     A      BA
line   .      B5     DM     BDM
line   .      B6     F      BF
line   .      B7     BB     BBB
line   .      B8     A      BA
section SOLO
speed  8
line   SOLO   S1     S1     SDM
line   SOLO   S2     S2     SBB
line   SOLO   S3     S3     SGM
line   SOLOFILL S4     S4     SA
section CHOIR
speed  7
line   TIMP   C1     CF     CF
line   TIMP   C2     CA     CA
line   TIMP   C3     CDM    CDM
line   TIMP   C4     CBB    CBB
line   TIMP   C5     CGM    CGM
line   ROLL   C6     CA     CA2
section HEAVY
speed  6
audctl $28
line   HEAVY  H1     .      R1
line   HEAVY  H2     .      R2
line   HEAVY  H1     .      R1
line   HEAVY  H3     .      R3
line   HEAVY  H4     .      R4
line   HFILL  H1     .      R2
line   HIT    H5     .      R5
section CODA
speed  10
audctl $00
line   .      B1     DM     BDM
line   .      E2     GM     BGM
line   .      E3     A      BA
line   .      E4     END    BEND
line   .      .      .      .
