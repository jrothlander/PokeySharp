# GUARDIAN - a boss battle, and the song that uses AUDCTL bit 7: the 9-bit poly.
# The format is in Demo1/CLAUDE.md, under "Song files". Instruments are tables with
# one entry per frame; each channel holds named tracks of sixteen rows; the lines at the
# end are the order list. In a track '.' holds and '-' releases. '#' starts a comment.
#
# AUDCTL bit 7 shortens POKEY's 17-bit noise counter to 9 bits, and the noise stops
# being noise. Measured on the emulator: a noise channel on the 17-bit counter never
# repeats, but on the 9-bit one it repeats every 73 underflows - not 511, because the
# channel samples the counter every 28 base clocks and 511 = 7 x 73 shares the 7 - so it
# becomes a pitched buzz: 876 Hz at divider 0, 125 Hz at divider 6. The hat turns into a
# metallic whine and the snare into a growl that falls as it decays. The same drum bar
# plays once each way before the fight starts, and the only change is one bit.
#
# E phrygian dominant - E F G# A B C D - the villain's scale. The bass keeps to E, F, G#,
# A and D, all within 11 cents on the buzz table; B and C, which miss by 26 and 31, stay
# out of the bass and in the lead.

song   GUARDIAN
key    E PHRYGIAN DOMINANT

# A click of tone, then the buzz table's divider climbing 20 to 80 - a pitch falling from
# 200 Hz to 50, as close to a thump as one channel gets. The 9-bit mode does not touch
# it: distortion C runs on the 4-bit counter.
instrument KICK
  table      none
  volume     15 14 13 11 9 7 5 3 1 0
  distortion tone buzz
  audf       40 20 27 34 43 52 62 71 80
  release    2

# One frame of tone for the crack, then noise. With bit 7 set the noise is the 9-bit
# counter, and dividers 6 to 13 are a buzz falling from 125 Hz to 58: a growl.
instrument SNARE
  table      none
  volume     14 13 11 9 7 6 5 4 3 2 1 0
  distortion tone noise
  audf       50 6 7 8 9 10 11 12 13
  release    2

# Noise at divider 0: hiss on the 17-bit counter, an 876 Hz whine on the 9-bit one.
instrument HAT
  table      none
  volume     7 4 2 1 0
  distortion noise
  audf       0
  release    2

instrument OPEN
  table      none
  volume     7 6 5 5 4 4 3 3 2 2 1 1 0
  distortion noise
  audf       0
  release    2

# The warning: a pure tone swept up and back over forty frames, two thirds of a second.
# Its dividers run 60 down to 22 and back, so the pitch climbs from 525 Hz to 1390 and
# falls again.
instrument SIREN
  table      none
  volume     10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 0
  distortion tone
  audf       60 58 56 54 52 50 48 46 44 42 40 38 36 34 32 30 28 26 24 22 24 26 28 30 32 34 36 38 40 42 44 46 48 50 52 54 56 58 60 62
  release    4

# Struck hard and short, so a sixteenth-note riff stays sixteen separate notes.
instrument RIFF
  table      buzz
  volume     12 11 9 8 7
  distortion buzz
  release    3

# The boss's voice: loud from the first frame, with vibrato arriving early on a held note.
instrument FURY
  table      tone
  volume     13 12 12 11 11 10
  distortion tone
  vibrato    0 1 1 0 -1 -1
  delay      10
  release    2

# A chord struck and cut off: the arpeggio, gone in five frames.
instrument STAB
  table      tone
  volume     9 8 6 4 2 0
  distortion tone
  release    2

channel 1 drums DRUMS
  note  The whole kit, and the song's point. With AUDCTL bit 7 set, the noise counter is
  note  nine bits instead of seventeen and repeats every 73 underflows, so the snare and
  note  hats stop being noise and become pitched - a metallic whine and a falling growl.
  note  The kick is untouched: it runs on the 4-bit counter. The warning siren is on this
  note  channel too, before the drums arrive.
  kit   K=KICK S=SNARE H=HAT O=OPEN A=SIREN
  track ALARM A . . .  . . . .  A . . .  . . . .
  track BEAT  K . H K  S . H K  K . H K  S . H H
  track BLAST K H S H  K H S H  K H S H  K S S S
  track DROP  K . . .  . . . .  . . . .  S S S S

channel 2 notes BASS
  note  A sixteenth-note riff on distortion C, relentless by design: a boss theme never
  note  lets the listener rest. E, F, G#, A and D all land within 11 cents on the buzz
  note  table, which is what chose the scale.
  voice RIFF
  track PEDAL E2 . . .  E2 . . .  E2 . . .  E2 . E2 .
  track RIFFE E2 E2 E3 E2  F2 E2 E3 E2  E2 E2 E3 E2  G#2 F2 E2 D2
  track RIFFF F2 F2 F1 F2  E2 F2 F1 F2  F2 F2 F1 F2  G#2 F2 E2 F2
  track RIFFA A1 A1 E2 A1  G#1 A1 E2 A1  A1 A1 E2 A1  C#2 D2 E2 F2
  track RIFFD D2 D2 D3 D2  C#2 D2 D3 D2  D2 D2 D3 D2  E2 F2 E2 D2
  track STOP  E2 . . .  - . . .  . . . .  E2 E2 E2 E2

channel 3 notes LEAD
  note  Pure tone, loud and early. The F over E is the half-step the scale is built on;
  note  the raised G# pulls every phrase back to E.
  voice FURY
  track A1  B4 . . .  E5 . . .  F5 . E5 .  D5 . C5 .
  track A2  C5 . . .  . . A4 .  C5 . F5 .  E5 . . .
  track A3  G#4 . B4 .  E5 . . .  F5 . . .  E5 . D5 .
  track A4  D5 . . .  C5 . . .  A4 . . .  G#4 . . .
  track B1  E5 F5 E5 D5  E5 . . .  E5 F5 E5 D5  C5 . B4 .
  track B2  F5 E5 F5 A5  F5 . . .  F5 E5 D5 C5  A4 . . .
  track B3  G#4 A4 B4 C5  D5 E5 F5 .  E5 . . .  - . . .
  track B4  A4 . C5 .  E5 . A5 .  G#5 . F5 .  E5 . . .
  track END E5 . . .  . . . .  . . . .  - . . .

channel 4 notes STABS
  note  Chords as short stabs off the beat: E major, F, A minor and D minor, each struck
  note  as an arpeggio and gone in five frames.
  voice STAB
  track SE   E . . E  . . E .  . . E .  E . . .
  track SF   F . . F  . . F .  . . F .  F . . .
  track SAM  Am . . Am  . . Am .  . . Am .  Am . . .
  track SDM  Dm . . Dm  . . Dm .  . . Dm .  Dm . . .
  track HIT  E . . .  - . . .  . . . .  . . . .

# The order list: one line per bar, a track per channel, '.' for none.
# Drums, bass, lead, stabs.
section WARNING
speed  5
audctl $00
line   ALARM  PEDAL  .      .
line   ALARM  PEDAL  .      .
# The same bar twice: the 17-bit counter, then bit 7 set.
section 17-BIT NOISE
line   BEAT   RIFFE  .      SE
section 9-BIT NOISE
audctl $80
line   BEAT   RIFFE  .      SE
loop
section BATTLE
line   BEAT   RIFFE  A1     SE
line   BEAT   RIFFF  A2     SF
line   BEAT   RIFFE  A3     SE
line   BLAST  RIFFD  A4     SDM
section RAGE
line   BLAST  RIFFE  B1     SE
line   BLAST  RIFFF  B2     SF
line   BLAST  RIFFE  B3     SE
line   BLAST  RIFFA  B4     SAM
section BATTLE
line   BEAT   RIFFE  A1     SE
line   BEAT   RIFFF  A2     SF
line   BEAT   RIFFE  A3     SE
line   BLAST  RIFFD  A4     SDM
section BREAK
line   DROP   STOP   END    HIT
