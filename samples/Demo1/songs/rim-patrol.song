# RIM PATROL - a song for Demo1's song page and tools/soundexport.
# The format is in Demo1/CLAUDE.md, under "Song files". Instruments are tables with
# one entry per frame; each channel holds named tracks of sixteen rows; the lines at the
# end are the order list. In a track '.' holds and '-' releases. '#' starts a comment.

song   RIM PATROL
key    D MINOR

# A click of tone, then the buzz table's divider climbing 20 to 80 - a pitch falling from
# 200 Hz to 50, as close to a thump as one channel gets.
instrument KICK
  table      none
  volume     15 14 13 11 9 7 5 3 1 0
  distortion tone buzz
  audf       40 20 27 34 43 52 62 71 80
  release    2

# One frame of tone for the crack, then the 17-bit poly for the rattle, darkening as it decays.
instrument SNARE
  table      none
  volume     14 13 11 9 7 6 5 4 3 2 1 0
  distortion tone noise
  audf       50 6 7 8 9 10 11 12 13
  release    2

# The poly at divider 0, the brightest noise the chip has, for four frames.
instrument HAT
  table      none
  volume     7 4 2 1 0
  distortion noise
  audf       0
  release    2

instrument OPEN
  table      none
  volume     7 6 5 5 4 4 3 3 2 2 1 1 0
  distortion noise
  audf       0
  release    2

# Distortion C: the buzz table, 7.5 times lower than a pure tone on the same divider.
instrument BASS
  table      buzz
  volume     13 12 11 10 10 9
  distortion buzz
  release    3

# Vibrato of one divider step either way, arriving only on a held note - on a short one it
# would read as out of tune rather than as expression.
instrument LEAD
  table      tone
  volume     12 11 11 10 10 9 9 9 8
  distortion tone
  vibrato    0 1 1 0 -1 -1
  delay      16
  release    1

# A chord is its notes one frame each in turn; the channel never holds more than one.
instrument ARPEGGIO
  table      tone
  volume     8 7 6 6 5 5 5 4
  distortion tone
  release    1

channel 1 drums DRUMS
  note  One channel for the whole kit, so only one drum sounds at a time - a hat cuts the
  note  kick off. Each drum is a table of frames: the kick is a click of tone and then
  note  distortion C falling away, the snare a click and then noise.
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track INTRO K . . .  H . . .  K . . .  H . O .
  track BEAT  K . H .  S . H .  K . K .  S . H .
  track DRIVE K . H H  S . H .  K . H K  S . O .
  track FILL  K . H .  S . H .  S . S S  . S S S

channel 2 notes BASS
  note  Distortion C, the Atari's bass. A pure tone on the 64 kHz clock cannot go below
  note  125 Hz, but the 4-bit poly makes the same divider sound 7.5 times lower. Only
  note  dividers whose AUDF+1 shares no factor with 15 give a clean note, so the table has
  note  gaps - and the song is in D minor because this table has no good C.
  voice BASS
  track DM    D2 - D2 D3  - D2 - D2  D2 - D2 D3  - D2 A1 -
  track BB    A#1 - A#1 F2  - A#1 - A#1  A#1 - A#1 F2  - A#1 F1 -
  track F     F2 - F2 F1  - F2 - F2  F2 - F2 F1  - F2 E2 -
  track A     A1 - A1 E2  - A1 - A1  A1 - A1 E2  - C#2 E2 -
  track DMEND D2 . . .  . . . .  D2 - D2 -  D2 - A1 -

channel 3 notes LEAD
  note  Pure tone, distortion A. The vibrato is the divider nudged one whole step either
  note  way once a note has been held a while - the coarsest vibrato there is, because a
  note  divider has no half steps.
  voice LEAD
  track A1 D5 . . .  A4 . C5 .  D5 . F5 .  E5 . D5 .
  track A2 D5 . . .  . . C5 .  A#4 . . .  A4 . F4 .
  track A3 C5 . . .  A4 . C5 .  F5 . . .  E5 . C5 .
  track A4 C#5 . . .  . . . .  E5 . . .  - . . .
  track B1 F5 . . .  E5 . D5 .  C5 . D5 .  A4 . . .
  track B2 A#4 . . .  C5 . D5 .  F5 . . .  D5 . . .
  track B3 C5 . A4 .  F4 . A4 .  C5 . F5 .  E5 . C5 .
  track B4 C#5 . . .  E5 . . .  A5 . . .  - . . .
  track C1 F5 . . .  . . . .  D5 . . .  F5 . . .
  track C2 A5 . . .  . . . .  G5 . F5 .  E5 . C5 .
  track C3 E5 . . .  C#5 . . .  A4 . C#5 .  E5 . . .
  track C4 D5 . . .  . . . .  . . . .  - . . .

channel 4 notes CHORDS
  note  One channel cannot play three notes, so it plays each for one frame in turn. Sixty
  note  changes a second is too fast to follow as a tune, and the ear hears a chord
  note  instead.
  voice ARPEGGIO
  track DM Dm . . .  . . Dm .  . . . .  Dm . . .
  track BB A# . . .  . . A# .  . . . .  A# . . .
  track F  F . . .  . . F .  . . . .  F . . .
  track A  A . . .  . . A .  . . . .  A . . .

# The order list: one line per bar, a track per channel, '.' for none.
speed  7
audctl $00
line   INTRO  DM     .      .
line   INTRO  BB     .      .
line   BEAT   F      .      F
line   FILL   A      .      A
loop
line   BEAT   DM     A1     DM
line   BEAT   BB     A2     BB
line   BEAT   F      A3     F
line   DRIVE  A      A4     A
line   BEAT   DM     B1     DM
line   BEAT   BB     B2     BB
line   BEAT   F      B3     F
line   FILL   A      B4     A
line   DRIVE  BB     C1     BB
line   DRIVE  F      C2     F
line   DRIVE  A      C3     A
line   FILL   DMEND  C4     DM
