# LANTERN TITLE
# The title screen: New song's Ballad style exactly as it comes - Moonlight triplets on a
# 16-bit piano over held roots, six-eight, no drums.
# LANTERN, a ballad suite for one game: TITLE, VILLAGE, JOURNEY, MEMORY, NIGHT, VICTORY,
# GAME OVER and CREDITS. All in C major or its relative A minor, piano-led, on one set of
# instruments. The title is New song's Ballad style with its defaults.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Style: Ballad - piano in six-eight.
# Chords: I vi IV V:  C Am F G; in B, vi ii V I:  Am Dm G C.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   LANTERN TITLE
key    C MAJOR
rows   12
beat   3

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Distortion C, for a bass. Its table skips notes - see which in the tracker's colours.
instrument BASS
  table      buzz
  volume     12 11 10 9 8
  distortion buzz
  release    3

# A piano: struck, falling away, and holding softly - 16-bit, so every note is within two cents.
instrument PIANO
  table      wide
  volume     13 12 11 10 10 9 9 8 8 7 7 6 6 5 5 5 4 4 4 3
  distortion tone
  release    3

channel 1 notes LEAD
  note  Empty: the tune is yours.
  voice LEAD

channel 2 notes BASS
  note  Bass: roots, on the chords' roots.
  voice BASS
  track INTRO C1 . .  . . .  B1 . .  . . .
  track INTRO2 A1 . .  . . .  G1 . .  . . .
  track A      C1 . .  C1 . .  C1 . .  B1 . .
  track A2     A1 . .  A1 . .  A1 . .  G1 . .
  track A3     F2 . .  F2 . .  F2 . .  F2 . .
  track A4     G2 . .  G2 . .  G2 . .  B2 . .
  track B      A1 . A1  . A1 .  A1 . A1  . C1 .
  track B2     D2 . D2  . D2 .  D2 . D2  . F2 .
  track B3     G2 . G2  . G2 .  G2 . G2  . B2 .
  track B4     C1 . C1  . A1 .  G2 . G2  . G2 .

channel 3 pair LOW BYTE
  note  The low byte of channel 4's 16-bit divider.

channel 4 notes PATTERN
  note  Moonlight triplets (5 8 10), on each chord.
  voice PIANO
  track INTRO G3 C4 E4  G3 C4 E4  G3 C4 E4  G3 C4 E4
  track INTRO2 E3 A3 C4  E3 A3 C4  D3 G3 B3  D3 G3 B3
  track A      G3 C4 E4  G3 C4 E4  G3 C4 E4  G3 C4 E4
  track A2     E3 A3 C4  E3 A3 C4  E3 A3 C4  E3 A3 C4
  track A3     C3 F3 A3  C3 F3 A3  C3 F3 A3  C3 F3 A3
  track A4     D3 G3 B3  D3 G3 B3  D3 G3 B3  D3 G3 B3
  track B      A2 E3 A3  C4 A3 E3  A2 E3 A3  C4 A3 E3
  track B2     D3 A3 D4  F4 D4 A3  D3 A3 D4  F4 D4 A3
  track B3     G2 D3 G3  B3 G3 D3  G2 D3 G3  B3 G3 D3
  track B4     C3 G3 C4  E4 C4 G3  G2 D3 G3  B3 G3 D3

# The order list: a section at a time.
audctl $28
speed  12
section INTRO
line   .  INTRO  .  INTRO
line   .  INTRO2  .  INTRO2
section A
loop
line   .  A  .  A
line   .  A2  .  A2
line   .  A3  .  A3
line   .  A4  .  A4
section B
line   .  B  .  B
line   .  B2  .  B2
line   .  B3  .  B3
line   .  B4  .  B4
