# LANTERN MEMORY
# A sad scene or flashback: the relative minor, slow six-eight, the 16-bit piano rolling
# 1-5-8-10; the chorus turns to Moonlight triplets.
# LANTERN, a ballad suite for one game: TITLE, VILLAGE, JOURNEY, MEMORY, NIGHT, VICTORY,
# GAME OVER and CREDITS. All in C major or its relative A minor, piano-led, on one set of
# instruments. The title is New song's Ballad style with its defaults.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: i VI III VII:  Am F C G; in B, i iv v i:  Am Dm Em Am.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   LANTERN MEMORY
key    A MINOR
rows   12
beat   3

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Distortion C, for a bass. Its table skips notes - see which in the tracker's colours.
instrument BASS
  table      buzz
  volume     12 11 10 9 8
  distortion buzz
  release    3

# A piano: struck, falling away, and holding softly - 16-bit, so every note is within two cents.
instrument PIANO
  table      wide
  volume     13 12 11 10 10 9 9 8 8 7 7 6 6 5 5 5 4 4 4 3
  distortion tone
  release    3

channel 1 notes LEAD
  note  Empty: the tune is yours.
  voice LEAD

channel 2 notes BASS
  note  Bass: roots, on the chords' roots.
  voice BASS
  track INTRO A1 . .  . . .  G1 . .  . . .
  track INTRO2 F2 . .  . . .  E2 . .  . . .
  track A      A1 . .  A1 . .  A1 . .  G1 . .
  track A2     F2 . .  F2 . .  F2 . .  D2 . .
  track A3     C1 . .  C1 . .  C1 . .  A1 . .
  track A4     G2 . .  F2 . .  E2 . .  G2 . .
  track B      A1 . A1  . A1 .  A1 . A1  . C1 .
  track B2     D2 . D2  . D2 .  D2 . D2  . D2 .
  track B3     E2 . E2  . E2 .  E2 . E2  . G2 .
  track B4     A1 . A1  . F1 .  E1 . E1  . G1 .

channel 3 pair LOW BYTE
  note  The low byte of channel 4's 16-bit divider.

channel 4 notes PATTERN
  note  Rolling 1-5-8-10, up and back, on each chord.
  voice PIANO
  track INTRO A3 E4 A4  C5 A4 E4  A3 E4 A4  C5 A4 E4
  track INTRO2 F3 C4 F4  A4 F4 C4  E3 B3 E4  G4 E4 B3
  track A      A3 E4 A4  C5 A4 E4  A3 E4 A4  C5 A4 E4
  track A2     F3 C4 F4  A4 F4 C4  F3 C4 F4  A4 F4 C4
  track A3     C4 G4 C5  E5 C5 G4  C4 G4 C5  E5 C5 G4
  track A4     G3 D4 G4  B4 G4 D4  E3 B3 E4  G4 E4 B3
  track B      E4 A4 C5  E4 A4 C5  E4 A4 C5  E4 A4 C5
  track B2     A3 D4 F4  A3 D4 F4  A3 D4 F4  A3 D4 F4
  track B3     B3 E4 G4  B3 E4 G4  B3 E4 G4  B3 E4 G4
  track B4     E4 A4 C5  E4 A4 C5  B3 E4 G4  B3 E4 G4

# The order list: a section at a time.
audctl $28
speed  13
section INTRO
line   .  INTRO  .  INTRO
line   .  INTRO2  .  INTRO2
section A
loop
line   .  A  .  A
line   .  A2  .  A2
line   .  A3  .  A3
line   .  A4  .  A4
section B
line   .  B  .  B
line   .  B2  .  B2
line   .  B3  .  B3
line   .  B4  .  B4
