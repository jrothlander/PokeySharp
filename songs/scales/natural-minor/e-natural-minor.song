# E NATURAL MINOR SCALE - a scale to hear, play along with, and read. Made by PokeyTracker's
# scale songs (File > New scale song), by rule: every note follows from the scale's steps.
# Whole, half, whole, whole, half, whole, whole: the major scale's notes from its sixth - darker, sadder.
# Going up:   E4 F#4 G4 A4 B4 C5 D5 E5
# The format is in Demo1/CLAUDE.md, under "Song files".

song   E NATURAL MINOR SCALE
key    E MINOR

# A soft piano-like voice on the 16-bit table: every note within two cents of true.
instrument PIANO
  table      wide
  volume     14 13 12 11 10 10 9 9 8 8 7 7 7 6
  distortion tone
  release    3

instrument HOME_NOTE
  table      wide
  volume     7 7 6
  distortion tone
  release    2

channel 1 pair LOW BYTE
  note  The low byte of channel 2's 16-bit divider. AUDCTL 78 joins 1 and 2, and 3 and 4.

channel 2 notes HOME
  note  The home note, held low under the scale when the drone is on - every note of the
  note  scale is heard against it, which is how a scale's character is learned. The lines
  note  play it where they name HOME; put . there to leave it out.
  voice HOME_NOTE
  track HOME E2 . . .  . . . .  . . . .  . . . .

channel 3 pair LOW BYTE
  note  The low byte of channel 4's 16-bit divider.

channel 4 notes SCALE
  note  E Natural Minor Scale: one octave up and down in quarter notes, two in eighths,
  note  and the home chord as an arpeggio.
  voice PIANO
  track O1 E4 . . .  F#4 . . .  G4 . . .  A4 . . .
  track O2 B4 . . .  C5 . . .  D5 . . .  E5 . . .
  track O3 D5 . . .  C5 . . .  B4 . . .  A4 . . .
  track O4 G4 . . .  F#4 . . .  E4 . . .  . . . .
  track T1 E4 . F#4 .  G4 . A4 .  B4 . C5 .  D5 . E5 .
  track T2 F#5 . G5 .  A5 . B5 .  C6 . D6 .  E6 . D6 .
  track T3 C6 . B5 .  A5 . G5 .  F#5 . E5 .  D5 . C5 .
  track T4 B4 . A4 .  G4 . F#4 .  E4 . . .  . . . .
  track A1 E4 . . .  G4 . . .  B4 . . .  E5 . . .
  track A2 G5 . . .  B5 . . .  E6 . . .  B5 . . .
  track A3 G5 . . .  E5 . . .  B4 . . .  G4 . . .
  track A4 E4 . . .  . . . .  . . . .  . . . .

# The order list: the scale's sections, then the song ends.
audctl $78
speed  11
section ONE OCTAVE
line   .  .     .  O1
line   .  .     .  O2
line   .  .     .  O3
line   .  .     .  O4
section TWO OCTAVES
line   .  .     .  T1
line   .  .     .  T2
line   .  .     .  T3
line   .  .     .  T4
section ARPEGGIO
line   .  .     .  A1
line   .  .     .  A2
line   .  .     .  A3
line   .  .     .  A4
end
