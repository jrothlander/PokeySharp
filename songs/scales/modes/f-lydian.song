# F LYDIAN SCALE - a scale to hear, play along with, and read. Made by PokeyTracker's
# scale songs (File > New scale song), by rule: every note follows from the scale's steps.
# Major with a raised fourth - the white notes from F. Floating, dreamy.
# Going up:   F4 G4 A4 B4 C5 D5 E5 F5
# The format is in Demo1/CLAUDE.md, under "Song files".

song   F LYDIAN SCALE
key    F LYDIAN

# A soft piano-like voice on the 16-bit table: every note within two cents of true.
instrument PIANO
  table      wide
  volume     14 13 12 11 10 10 9 9 8 8 7 7 7 6
  distortion tone
  release    3

instrument HOME_NOTE
  table      wide
  volume     7 7 6
  distortion tone
  release    2

channel 1 pair LOW BYTE
  note  The low byte of channel 2's 16-bit divider. AUDCTL 78 joins 1 and 2, and 3 and 4.

channel 2 notes HOME
  note  The home note, held low under the scale when the drone is on - every note of the
  note  scale is heard against it, which is how a scale's character is learned. The lines
  note  play it where they name HOME; put . there to leave it out.
  voice HOME_NOTE
  track HOME F2 . . .  . . . .  . . . .  . . . .

channel 3 pair LOW BYTE
  note  The low byte of channel 4's 16-bit divider.

channel 4 notes SCALE
  note  F Lydian Scale: one octave up and down in quarter notes, two in eighths,
  note  and the home chord as an arpeggio.
  voice PIANO
  track O1 F4 . . .  G4 . . .  A4 . . .  B4 . . .
  track O2 C5 . . .  D5 . . .  E5 . . .  F5 . . .
  track O3 E5 . . .  D5 . . .  C5 . . .  B4 . . .
  track O4 A4 . . .  G4 . . .  F4 . . .  . . . .
  track T1 F4 . G4 .  A4 . B4 .  C5 . D5 .  E5 . F5 .
  track T2 G5 . A5 .  B5 . C6 .  D6 . E6 .  F6 . E6 .
  track T3 D6 . C6 .  B5 . A5 .  G5 . F5 .  E5 . D5 .
  track T4 C5 . B4 .  A4 . G4 .  F4 . . .  . . . .
  track A1 F4 . . .  A4 . . .  C5 . . .  F5 . . .
  track A2 A5 . . .  C6 . . .  F6 . . .  C6 . . .
  track A3 A5 . . .  F5 . . .  C5 . . .  A4 . . .
  track A4 F4 . . .  . . . .  . . . .  . . . .

# The order list: the scale's sections, then the song ends.
audctl $78
speed  11
section ONE OCTAVE
line   .  .     .  O1
line   .  .     .  O2
line   .  .     .  O3
line   .  .     .  O4
section TWO OCTAVES
line   .  .     .  T1
line   .  .     .  T2
line   .  .     .  T3
line   .  .     .  T4
section ARPEGGIO
line   .  .     .  A1
line   .  .     .  A2
line   .  .     .  A3
line   .  .     .  A4
end
