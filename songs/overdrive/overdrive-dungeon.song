# OVERDRIVE DUNGEON
# Danger and night levels: six-eight, no drums, Moonlight triplets on the 16-bit piano over
# held roots, descending.
# OVERDRIVE, a suite for one game: TITLE, STAGE, BOSS, CALM, DUNGEON, VICTORY, GAME OVER and
# CREDITS. All in F# minor or its relative A major, on one set of instruments, so the cues
# sound like one game. The stage's chords, i - VI - III - VII, open the title too.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: i VII VI v:  F#m E D C#m; in B, i iv v i:  F#m Bm C#m F#m.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   OVERDRIVE DUNGEON
key    F# MINOR
rows   12
beat   3

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Distortion C, for a bass. Its table skips notes - see which in the tracker's colours.
instrument BASS
  table      buzz
  volume     12 11 10 9 8
  distortion buzz
  release    3

# A piano: struck, falling away, and holding softly - 16-bit, so every note is within two cents.
instrument PIANO
  table      wide
  volume     13 12 11 10 10 9 9 8 8 7 7 6 6 5 5 5 4 4 4 3
  distortion tone
  release    3

channel 1 notes LEAD
  note  Empty: the tune is yours.
  voice LEAD

channel 2 notes BASS
  note  Bass: roots, on the chords' roots.
  voice BASS
  track INTRO F#2 . .  . . .  F#2 . .  . . .
  track INTRO2 E2 . .  . . .  C#2 . .  . . .
  track A      F#2 . .  F#2 . .  F#2 . .  F#2 . .
  track A2     E2 . .  E2 . .  E2 . .  E2 . .
  track A3     D2 . .  D2 . .  D2 . .  D2 . .
  track A4     C#2 . .  C#2 . .  C#2 . .  E2 . .
  track B      F#1 . F#1  . F#1 .  F#1 . F#1  . A1 .
  track B2     B2 . B2  . B2 .  B2 . B2  . B2 .
  track B3     C#2 . C#2  . C#2 .  C#2 . C#2  . E2 .
  track B4     F#2 . F#2  . D2 .  C#2 . C#2  . E2 .

channel 3 pair LOW BYTE
  note  The low byte of channel 4's 16-bit divider.

channel 4 notes PATTERN
  note  Moonlight triplets (5 8 10), on each chord.
  voice PIANO
  track INTRO C#4 F#4 A4  C#4 F#4 A4  C#4 F#4 A4  C#4 F#4 A4
  track INTRO2 B3 E4 G#4  B3 E4 G#4  G#3 C#4 E4  G#3 C#4 E4
  track A      C#4 F#4 A4  C#4 F#4 A4  C#4 F#4 A4  C#4 F#4 A4
  track A2     B3 E4 G#4  B3 E4 G#4  B3 E4 G#4  B3 E4 G#4
  track A3     A3 D4 F#4  A3 D4 F#4  A3 D4 F#4  A3 D4 F#4
  track A4     G#3 C#4 E4  G#3 C#4 E4  G#3 C#4 E4  G#3 C#4 E4
  track B      F#3 C#4 F#4  A4 F#4 C#4  F#3 C#4 F#4  A4 F#4 C#4
  track B2     B2 F#3 B3  D4 B3 F#3  B2 F#3 B3  D4 B3 F#3
  track B3     C#3 G#3 C#4  E4 C#4 G#3  C#3 G#3 C#4  E4 C#4 G#3
  track B4     F#3 C#4 F#4  A4 F#4 C#4  C#3 G#3 C#4  E4 C#4 G#3

# The order list: a section at a time.
audctl $28
speed  11
section INTRO
line   .  INTRO  .  INTRO
line   .  INTRO2  .  INTRO2
section A
loop
line   .  A  .  A
line   .  A2  .  A2
line   .  A3  .  A3
line   .  A4  .  A4
section B
line   .  B  .  B
line   .  B2  .  B2
line   .  B3  .  B3
line   .  B4  .  B4
