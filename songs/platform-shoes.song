# PLATFORM SHOES - an original disco song, in the style of the late 1970s.
# The format is in Demo1/CLAUDE.md, under "Song files". Instruments are tables with
# one entry per frame; each channel holds named tracks of sixteen rows; the lines at the
# end are the order list. In a track '.' holds and '-' releases. '#' starts a comment.
#
# The style is everyone's; the tune is its own. What makes disco disco is a handful of
# habits, and every one of them fits a channel: the kick on every beat (four on the
# floor), an open hi-hat on every off-beat, a clap on two and four, a bass that jumps
# an octave every eighth note, and short chord stabs in the gaps. No melody, bass line or
# hook here comes from a record.
#
# F# minor because the bass is on distortion C and has to play every chord's root in two
# octaves at once: F#, D and E are within 10 cents on the buzz table in both octaves, and
# C# within 14. B and A, which it misses by 26 and 33, stay out of the bass.
#
# One drum channel does three drums at once, because two of them never need to be
# separate: on two and four the kick and the clap sound together, so they are one
# instrument - a frame of thump on the buzz table, then noise - and the kit plays K, X
# and H where a drummer would play three drums.

song   PLATFORM SHOES
key    F# MINOR

# --- The drum machine ----------------------------------------------------------------

# Guardian's kick: a click of tone, then the buzz table's divider falling as a thump.
instrument KICK
  table      none
  volume     15 14 13 11 9 7 5 3 1 0
  distortion tone buzz
  audf       40 20 27 34 43 52 62 71 80
  release    2

# Kick and clap together: two frames of the kick's thump, then a burst of noise.
instrument KICKCLAP
  table      none
  volume     15 14 13 12 11 9 7 5 3 2 1 0
  distortion tone buzz noise
  audf       40 20 10 12 14 16 18 20 22
  release    2

# The clap alone, for fills.
instrument CLAP
  table      none
  volume     12 11 9 7 5 3 2 1 0
  distortion noise
  audf       10 12 14 16 18
  release    2

# The open hi-hat on the off-beat: Guardian's, the noise at divider 0, ringing.
instrument OPENHAT
  table      none
  volume     7 6 5 5 4 4 3 3 2 2 1 1 0
  distortion noise
  audf       0
  release    2

instrument CLOSEDHAT
  table      none
  volume     5 3 1 0
  distortion noise
  audf       0
  release    2

# --- The band ------------------------------------------------------------------------

# The octave bass: struck and gone before the next eighth, so every jump is heard.
instrument OCTAVE_BASS
  table      buzz
  volume     12 11 9 7 5 4 3
  distortion buzz
  release    3

# The rhythm guitar: a chord scratched and cut, gone in six frames.
instrument SCRATCH
  table      tone
  volume     9 8 6 4 2 1 0
  distortion tone
  release    2

# The lead: steady, with a slow, shallow vibrato that only arrives on a held note -
# five wobbles a second, starting twenty frames in.
instrument LEAD
  table      tone
  volume     11 12 11 11 10 10 10 9
  distortion tone
  vibrato    0 0 0 1 1 1 0 0 0 -1 -1 -1
  delay      20
  release    2

channel 1 drums DRUMS
  note  Four on the floor: a kick on every beat, the open hat on every off-beat, and on
  note  two and four the kick and clap as one instrument. The break adds closed hats on
  note  every sixteenth, and the fill is claps.
  kit   K=KICK X=KICKCLAP C=CLAP H=OPENHAT h=CLOSEDHAT
  track FLOOR K . H .  K . H .  K . H .  K . H .
  track DISCO K . H .  X . H .  K . H .  X . H .
  track BREAK K h H h  X h H h  K h H h  X h H h
  track FILL  K . H .  X . H .  C . C C  C C C C

channel 2 notes BASS
  note  Octaves on distortion C: the root, then the root an octave up, bouncing on the
  note  eighths with a push on the sixteenth before the third beat. The key was chosen so
  note  every root is in tune in both octaves.
  voice OCTAVE_BASS
  track FM  F#1 . F#2 .  F#1 . F#2 F#1  . F#1 F#2 .  E1 . E2 .
  track D   D1 . D2 .  D1 . D2 D1  . D1 D2 .  D1 . D2 .
  track E   E1 . E2 .  E1 . E2 E1  . E1 E2 .  G#1 . G#2 .
  track CM  C#1 . C#2 .  C#1 . C#2 C#1  . C#1 C#2 .  C#1 . C#2 .
  track FM2 F#1 . F#2 .  F#1 . F#2 .  F#1 . F#2 .  F#1 . F#2 .

channel 3 notes GUITAR
  note  Chords scratched on the off-beat sixteenths, never on a beat - the kick owns the
  note  beats. Each is an arpeggio cut off in six frames.
  voice SCRATCH
  track FM  . . F#m .  . F#m . .  . . F#m .  . F#m . .
  track D   . . D .  . D . .  . . D .  . D . .
  track E   . . E .  . E . .  . . E .  . E . .
  track CM  . . C#m .  . C#m . .  . . C#m .  . C#m . .

channel 4 notes LEAD
  note  The tune. The verse sits low and syncopated, landing just before the beat. The
  note  chorus climbs to F#5, the top of the range where the pure-tone table is in tune.
  voice LEAD
  track A1  C#5 . . C#5  . . A4 .  B4 . C#5 .  . . . .
  track A2  . . A4 .  B4 . A4 .  F#4 . . .  E4 . F#4 .
  track A3  A4 . . A4  . . D5 .  C#5 . D5 .  E5 . . .
  track A4  . . D5 .  C#5 . B4 .  G#4 . . .  - . . .
  track A5  C#5 . . C#5  . . E5 .  D5 . C#5 .  . . . .
  track A6  . . B4 .  C#5 . B4 .  A4 . . .  F#4 . A4 .
  track A7  B4 . . B4  . . A4 .  F#4 . A4 .  B4 . . .
  track A8  . . B4 .  C#5 . D5 .  E5 . . .  - . . .
  track B1  F#5 . . .  E5 . D5 .  . . E5 .  F#5 . . .
  track B2  . . E5 .  D5 . B4 .  . . . .  B4 . C#5 .
  track B3  E5 . . .  . . C#5 .  . . E5 .  . . G#4 .
  track B4  A4 . . .  . . . .  - . . .  C#5 . E5 .
  track B6  . . E5 .  F#5 . E5 .  . . D5 .  C#5 . B4 .
  track B7  C#5 . . .  . . E5 .  . . G#4 .  B4 . . .
  track B8  F#4 . . .  . . . .  . . . .  - . . .

# The order list: one line per bar. Drums, bass, guitar, lead.
speed  8
audctl $00
section INTRO
line   FLOOR  FM2    .      .
line   FLOOR  FM2    .      .
line   DISCO  FM     FM     .
line   DISCO  FM     FM     .
loop
section VERSE
line   DISCO  FM     FM     A1
line   DISCO  FM     FM     A2
line   DISCO  D      D      A3
line   DISCO  E      E      A4
line   DISCO  FM     FM     A5
line   DISCO  FM     FM     A6
line   DISCO  D      D      A7
line   DISCO  E      E      A8
section CHORUS
line   DISCO  D      D      B1
line   DISCO  E      E      B2
line   DISCO  CM     CM     B3
line   DISCO  FM     FM     B4
line   DISCO  D      D      B1
line   DISCO  E      E      B6
line   DISCO  CM     CM     B7
line   FILL   FM     FM     B8
section BREAK
line   BREAK  FM2    .      .
line   BREAK  FM2    .      .
line   BREAK  FM2    FM     .
line   FILL   FM2    FM     .
