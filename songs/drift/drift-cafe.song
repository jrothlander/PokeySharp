# DRIFT CAFE
# The cafe, shop or hub: the jazz turnaround, soft keys rocking 1-5-8-9-10 over a walking
# bass; the chorus turns to the 50s progression.
# DRIFT, a chill suite for one game: TITLE, CAFE, FIELD, RAIN, NIGHT, VICTORY, GAME OVER and
# CREDITS. All in B flat major or its relative G minor, laid-back, on one set of
# instruments. The title is New song's Chill style with its defaults, in B flat. The bass
# throughout is SOFTBASS, a pure tone, in place of the buzz.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: ii V I I:  Cm F Bb Bb; in B, I vi IV V:  Bb Gm Eb F.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   DRIFT CAFE
key    B FLAT MAJOR

# A soft, round bass: the pure tone, plucked and fading - no buzz, one channel, every note
# in tune from C3 up.
instrument SOFTBASS
  table      tone
  volume     12 11 10 9 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    2

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Soft keys for an accompaniment: struck, then falling away.
instrument KEYS
  table      tone
  volume     11 10 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    3

# Four drums: a falling thump, a burst of noise, and a short and a long hiss. Each is a
# table of registers a frame at a time, with no note table, so a key only says which drum.
instrument KICK
  table      none
  volume     15 13 10 7 4 2 0
  distortion buzz
  audf       40 55 70 85 100 115 130

instrument SNARE
  table      none
  volume     13 11 9 7 5 4 3 2 1 0
  distortion tone noise
  audf       50 8 9 10 11 12 13

instrument HAT
  table      none
  volume     8 5 3 1 0
  distortion noise
  audf       2

instrument OPEN
  table      none
  volume     8 7 6 5 4 3 2 2 1 1 0
  distortion noise
  audf       1

channel 1 drums DRUMS
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track INTRO K . H .  H . H .  S . H .  H . H .
  track INTRO2 K . H .  S . H .  K . S .  S S S S
  track A      K . H .  H . H .  S . H .  H . H .
  track A2     K . H .  S . H .  K . S .  S S S S
  track B      K . . .  S . . .  K . . .  S . . .
  track B2     S . S .  S . S .  S S S S  S S S S
  track BRIDGE K . H .  H . H .  S . H .  H . H .
  track BRIDGE2 K . H .  S . H .  S . S S  S S S S

channel 2 notes BASS
  note  Bass: root and fifth, on the chords' roots.
  voice SOFTBASS
  track INTRO C3 . . .  . . . .  Eb3 . . .  . . . .
  track INTRO2 F3 . . .  . . . .  D3 . . .  . . . .
  track A      C3 . . .  G3 . . .  C3 . . .  Eb3 . . .
  track A2     F3 . . .  C4 . . .  F3 . . .  A3 . . .
  track A3     Bb3 . . .  F4 . . .  Bb3 . . .  F4 . . .
  track A4     Bb3 . . .  G3 . . .  F3 . . .  D3 . . .
  track B      Bb3 . F4 .  Bb3 . F4 .  Bb3 . F4 .  Bb3 . A3 .
  track B2     G3 . D4 .  G3 . D4 .  G3 . D4 .  G3 . F3 .
  track B3     Eb3 . Bb3 .  Eb3 . Bb3 .  Eb3 . Bb3 .  Eb3 . Bb3 .
  track B4     F3 . C4 .  F3 . C4 .  F3 . C4 .  F3 . A3 .
  track BRIDGE C3 . . .  . . . .  . . . .  . . . .
  track BRIDGE2 F3 . . .  . . . .  . . . .  . . . .

channel 3 notes LEAD
  note  Empty: the tune is yours.
  voice LEAD

channel 4 notes PATTERN
  note  1-5-8-9-10, up and back, on each chord.
  voice KEYS
  track INTRO C4 . G4 .  C5 . D5 .  Eb5 . D5 .  C5 . G4 .
  track INTRO2 F3 . C4 .  F4 . G4 .  A4 . G4 .  F4 . C4 .
  track A      C4 . G4 .  C5 . D5 .  Eb5 . D5 .  C5 . G4 .
  track A2     F3 . C4 .  F4 . G4 .  A4 . G4 .  F4 . C4 .
  track A3     Bb3 . F4 .  Bb4 . C5 .  D5 . C5 .  Bb4 . F4 .
  track A4     Bb3 . F4 .  Bb4 . C5 .  A4 . G4 .  F4 . C4 .
  track B      Bb3 . D4 .  F4 . Bb4 .  D5 . Bb4 .  F4 . D4 .
  track B2     G3 . Bb3 .  D4 . G4 .  Bb4 . G4 .  D4 . Bb3 .
  track B3     Eb3 . G3 .  Bb3 . Eb4 .  G4 . Eb4 .  Bb3 . G3 .
  track B4     F3 . A3 .  C4 . F4 .  A4 . F4 .  C4 . A3 .
  track BRIDGE C4 . G4 .  C5 . D5 .  Eb5 . D5 .  C5 . G4 .
  track BRIDGE2 F3 . C4 .  F4 . G4 .  A4 . G4 .  F4 . C4 .

# The order list: a section at a time.
speed  9
section INTRO
line   INTRO  INTRO  .  INTRO
line   INTRO2  INTRO2  .  INTRO2
section A
loop
line   A  A  .  A
line   A  A2  .  A2
line   A  A3  .  A3
line   A2  A4  .  A4
section B
line   B  B  .  B
line   B  B2  .  B2
line   B  B3  .  B3
line   B2  B4  .  B4
section A
line   A  A  .  A
line   A  A2  .  A2
line   A  A3  .  A3
line   A2  A4  .  A4
section BRIDGE
line   BRIDGE  BRIDGE  .  BRIDGE
line   BRIDGE2  BRIDGE2  .  BRIDGE2
