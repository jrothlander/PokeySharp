# DRIFT RAIN
# A rainy, quiet moment: G minor, a broken chord on the 16-bit piano over held roots and a
# half-time beat; the chorus turns to i - iv - v.
# DRIFT, a chill suite for one game: TITLE, CAFE, FIELD, RAIN, NIGHT, VICTORY, GAME OVER and
# CREDITS. All in B flat major or its relative G minor, laid-back, on one set of
# instruments. The title is New song's Chill style with its defaults, in B flat.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: i VI III VII:  Gm Eb Bb F; in B, i iv v i:  Gm Cm Dm Gm.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   DRIFT RAIN
key    G MINOR

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Distortion C, for a bass. Its table skips notes - see which in the tracker's colours.
instrument BASS
  table      buzz
  volume     12 11 10 9 8
  distortion buzz
  release    3

# A piano: struck, falling away, and holding softly - 16-bit, so every note is within two cents.
instrument PIANO
  table      wide
  volume     13 12 11 10 10 9 9 8 8 7 7 6 6 5 5 5 4 4 4 3
  distortion tone
  release    3

channel 1 notes LEAD
  note  Empty: the tune is yours.
  voice LEAD

channel 2 notes BASS
  note  Bass: roots, on the chords' roots.
  voice BASS
  track INTRO G2 . . .  . . . .  F2 . . .  . . . .
  track INTRO2 Eb1 . . .  . . . .  D1 . . .  . . . .
  track A      G2 . . .  G2 . . .  G2 . . .  F2 . . .
  track A2     Eb1 . . .  Eb1 . . .  Eb1 . . .  C1 . . .
  track A3     Bb1 . . .  Bb1 . . .  Bb1 . . .  G1 . . .
  track A4     F1 . . .  Eb1 . . .  D1 . . .  F1 . . .
  track B      G1 . G1 .  G1 . G1 .  G1 . G1 .  G1 . Bb1 .
  track B2     C1 . C1 .  C1 . C1 .  C1 . C1 .  C1 . C1 .
  track B3     D2 . D2 .  D2 . D2 .  D2 . D2 .  D2 . F2 .
  track B4     G1 . G1 .  G1 . Eb1 .  D1 . D1 .  D1 . F1 .

channel 3 pair LOW BYTE
  note  The low byte of channel 4's 16-bit divider.

channel 4 notes PATTERN
  note  Broken chord, up and back, on each chord.
  voice PIANO
  track INTRO G3 . Bb3 .  D4 . G4 .  Bb4 . G4 .  D4 . Bb3 .
  track INTRO2 Eb3 . G3 .  Bb3 . Eb4 .  F4 . D4 .  A3 . F3 .
  track A      G3 . Bb3 .  D4 . G4 .  Bb4 . G4 .  D4 . Bb3 .
  track A2     Eb3 . G3 .  Bb3 . Eb4 .  G4 . Eb4 .  Bb3 . G3 .
  track A3     Bb3 . D4 .  F4 . Bb4 .  D5 . Bb4 .  F4 . D4 .
  track A4     F3 . A3 .  C4 . F4 .  F4 . D4 .  A3 . F3 .
  track B      G3 . D4 .  G4 . A4 .  Bb4 . A4 .  G4 . D4 .
  track B2     C3 . G3 .  C4 . D4 .  Eb4 . D4 .  C4 . G3 .
  track B3     D3 . A3 .  D4 . Eb4 .  F4 . Eb4 .  D4 . A3 .
  track B4     G3 . D4 .  G4 . A4 .  F4 . Eb4 .  D4 . A3 .

# The order list: a section at a time.
audctl $28
speed  10
section INTRO
line   .  INTRO  .  INTRO
line   .  INTRO2  .  INTRO2
section A
loop
line   .  A  .  A
line   .  A2  .  A2
line   .  A3  .  A3
line   .  A4  .  A4
section B
line   .  B  .  B
line   .  B2  .  B2
line   .  B3  .  B3
line   .  B4  .  B4
