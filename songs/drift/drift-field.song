# DRIFT FIELD
# Wandering outdoors: six-eight, soft keys rolling 1-5-8-10 over the roots; the chorus lifts
# IV - V - I.
# DRIFT, a chill suite for one game: TITLE, CAFE, FIELD, RAIN, NIGHT, VICTORY, GAME OVER and
# CREDITS. All in B flat major or its relative G minor, laid-back, on one set of
# instruments. The title is New song's Chill style with its defaults, in B flat.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: I IV vi V:  Bb Eb Gm F; in B, IV V I I:  Eb F Bb Bb.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   DRIFT FIELD
key    B FLAT MAJOR
rows   12
beat   3

# Distortion C, for a bass. Its table skips notes - see which in the tracker's colours.
instrument BASS
  table      buzz
  volume     12 11 10 9 8
  distortion buzz
  release    3

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Soft keys for an accompaniment: struck, then falling away.
instrument KEYS
  table      tone
  volume     11 10 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    3

# Four drums: a falling thump, a burst of noise, and a short and a long hiss. Each is a
# table of registers a frame at a time, with no note table, so a key only says which drum.
instrument KICK
  table      none
  volume     15 13 10 7 4 2 0
  distortion buzz
  audf       40 55 70 85 100 115 130

instrument SNARE
  table      none
  volume     13 11 9 7 5 4 3 2 1 0
  distortion tone noise
  audf       50 8 9 10 11 12 13

instrument HAT
  table      none
  volume     8 5 3 1 0
  distortion noise
  audf       2

instrument OPEN
  table      none
  volume     8 7 6 5 4 3 2 2 1 1 0
  distortion noise
  audf       1

channel 1 drums DRUMS
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track INTRO K . H  S . H  K . H  S . H
  track INTRO2 K . .  S . .  S S S  S S S
  track A      K . H  S . H  K . H  S . H
  track A2     K . .  S . .  S S S  S S S
  track B      K . H  S . H  K . H  S . H
  track B2     K . .  S . .  S S S  S S S

channel 2 notes BASS
  note  Bass: roots, on the chords' roots.
  voice BASS
  track INTRO Bb1 . .  . . .  D2 . .  . . .
  track INTRO2 Eb1 . .  . . .  F1 . .  . . .
  track A      Bb1 . .  Bb1 . .  Bb1 . .  D2 . .
  track A2     Eb1 . .  Eb1 . .  Eb1 . .  F1 . .
  track A3     G2 . .  G2 . .  G2 . .  G2 . .
  track A4     F1 . .  F1 . .  F1 . .  A1 . .
  track B      Eb1 . Eb1  . Eb1 .  Eb1 . Eb1  . Eb1 .
  track B2     F1 . F1  . F1 .  F1 . F1  . A1 .
  track B3     Bb1 . Bb1  . Bb1 .  Bb1 . Bb1  . Bb1 .
  track B4     Bb1 . Bb1  . G1 .  F1 . F1  . F1 .

channel 3 notes LEAD
  note  Empty: the tune is yours.
  voice LEAD

channel 4 notes PATTERN
  note  Rolling 1-5-8-10, up and back, on each chord.
  voice KEYS
  track INTRO Bb3 F4 Bb4  D5 Bb4 F4  Bb3 F4 Bb4  D5 Bb4 F4
  track INTRO2 Eb3 Bb3 Eb4  G4 Eb4 Bb3  F3 C4 F4  A4 F4 C4
  track A      Bb3 F4 Bb4  D5 Bb4 F4  Bb3 F4 Bb4  D5 Bb4 F4
  track A2     Eb3 Bb3 Eb4  G4 Eb4 Bb3  Eb3 Bb3 Eb4  G4 Eb4 Bb3
  track A3     G3 D4 G4  Bb4 G4 D4  G3 D4 G4  Bb4 G4 D4
  track A4     F3 C4 F4  A4 F4 C4  F3 C4 F4  A4 F4 C4
  track B      Eb3 Bb3 Eb4  G4 Eb4 Bb3  Eb3 Bb3 Eb4  G4 Eb4 Bb3
  track B2     F3 C4 F4  A4 F4 C4  F3 C4 F4  A4 F4 C4
  track B3     Bb3 F4 Bb4  D5 Bb4 F4  Bb3 F4 Bb4  D5 Bb4 F4
  track B4     Bb3 F4 Bb4  D5 Bb4 F4  F3 C4 F4  A4 F4 C4

# The order list: a section at a time.
speed  10
section INTRO
line   INTRO  INTRO  .  INTRO
line   INTRO2  INTRO2  .  INTRO2
section A
loop
line   A  A  .  A
line   A  A2  .  A2
line   A  A3  .  A3
line   A2  A4  .  A4
section B
line   B  B  .  B
line   B  B2  .  B2
line   B  B3  .  B3
line   B2  B4  .  B4
