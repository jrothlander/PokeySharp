# PIANO BALLAD SKELETON
# A skeleton in a common piano-ballad form of the late 1980s: a piano intro, verse and chorus
# twice, a bridge for the emotional peak, the chorus twice more, an ending. No drums, no
# pre-chorus, no riff - one broken-chord piano part carries it, rolling 1-5-8-9-10 in the
# chorus. Key, chords and tempo here are this skeleton's own (D major, I - V - vi - IV, then
# IV - V - I), not any song's; change them by ear. Channel 1 is empty for your tune: a verse
# written once plays in both verses, a chorus in every chorus. Lift the chorus melody higher.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: I V vi IV:  D A Bm G; in B, IV V I I:  G A D D.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   PIANO BALLAD SKELETON
key    D MAJOR

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# A soft, round bass: the pure tone, plucked and fading - no buzz, one channel, every note
# in tune from C3 up.
instrument SOFTBASS
  table      tone
  volume     12 11 10 9 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    2

# A piano: struck, falling away, and holding softly - 16-bit, so every note is within two cents.
instrument PIANO
  table      wide
  volume     13 12 11 10 10 9 9 8 8 7 7 6 6 5 5 5 4 4 4 3
  distortion tone
  release    3

channel 1 notes LEAD
  note  Empty: the tune is yours.
  voice LEAD
  track INTRO . . . .  . . . .  . . . .  . . . .
  track INTRO2 . . . .  . . . .  . . . .  . . . .
  track A      . . . .  . . . .  . . . .  . . . .
  track A2     . . . .  . . . .  . . . .  . . . .
  track A3     . . . .  . . . .  . . . .  . . . .
  track A4     . . . .  . . . .  . . . .  . . . .
  track B      . . . .  . . . .  . . . .  . . . .
  track B2     . . . .  . . . .  . . . .  . . . .
  track B3     . . . .  . . . .  . . . .  . . . .
  track B4     . . . .  . . . .  . . . .  . . . .
  track BRIDGE . . . .  . . . .  . . . .  . . . .
  track BRIDGE2 . . . .  . . . .  . . . .  . . . .
  track END     . . . .  . . . .  . . . .  . . . .

channel 2 notes BASS
  note  Bass: roots, on the chords' roots.
  voice SOFTBASS
  track INTRO D3 . . .  . . . .  B2 . . .  . . . .
  track INTRO2 A3 . . .  . . . .  C#4 . . .  . . . .
  track A      D3 . . .  D3 . . .  D3 . . .  B2 . . .
  track A2     A3 . . .  A3 . . .  A3 . . .  A3 . . .
  track A3     B3 . . .  B3 . . .  B3 . . .  A3 . . .
  track A4     G3 . . .  G3 . . .  A3 . . .  C#4 . . .
  track B      G3 . G3 .  G3 . G3 .  G3 . G3 .  G3 . G3 .
  track B2     A3 . A3 .  A3 . A3 .  A3 . A3 .  A3 . C#4 .
  track B3     D3 . D3 .  D3 . D3 .  D3 . D3 .  D3 . D3 .
  track B4     D3 . D3 .  D3 . B2 .  A3 . A3 .  A3 . A3 .
  track BRIDGE D3 . . .  . . . .  . . . .  . . . .
  track BRIDGE2 A3 . . .  . . . .  . . . .  . . . .
  track END     D3 . . .  . . . .  . . . .  . . . .

channel 3 pair LOW BYTE
  note  The low byte of channel 4's 16-bit divider.

channel 4 notes PATTERN
  note  Broken chord, up and back, on each chord.
  voice PIANO
  track INTRO D3 . F#3 .  A3 . D4 .  F#4 . D4 .  A3 . F#3 .
  track INTRO2 A2 . C#3 .  E3 . A3 .  C#4 . A3 .  E3 . C#3 .
  track A      D3 . F#3 .  A3 . D4 .  F#4 . D4 .  A3 . F#3 .
  track A2     A2 . C#3 .  E3 . A3 .  C#4 . A3 .  E3 . C#3 .
  track A3     B2 . D3 .  F#3 . B3 .  D4 . B3 .  F#3 . D3 .
  track A4     G2 . B2 .  D3 . G3 .  C#4 . A3 .  E3 . C#3 .
  track B      G2 . D3 .  G3 . A3 .  B3 . A3 .  G3 . D3 .
  track B2     A2 . E3 .  A3 . B3 .  C#4 . B3 .  A3 . E3 .
  track B3     D3 . A3 .  D4 . E4 .  F#4 . E4 .  D4 . A3 .
  track B4     D3 . A3 .  D4 . E4 .  C#4 . B3 .  A3 . E3 .
  track BRIDGE D3 . F#3 .  A3 . D4 .  F#4 . D4 .  A3 . F#3 .
  track BRIDGE2 A2 . C#3 .  E3 . A3 .  C#4 . A3 .  E3 . C#3 .
  track END     D3 . . .  . . . .  . . . .  . . . .

# The order list: a section at a time.
audctl $28
speed  11
section INTRO
line   INTRO  INTRO  .  INTRO
line   INTRO2  INTRO2  .  INTRO2
section A
line   A  A  .  A
line   A2 A2  .  A2
line   A3 A3  .  A3
line   A4 A4  .  A4
section B
line   B  B  .  B
line   B2 B2  .  B2
line   B3 B3  .  B3
line   B4 B4  .  B4
section A
line   A  A  .  A
line   A2 A2  .  A2
line   A3 A3  .  A3
line   A4 A4  .  A4
section B
line   B  B  .  B
line   B2 B2  .  B2
line   B3 B3  .  B3
line   B4 B4  .  B4
section BRIDGE
line   BRIDGE  BRIDGE  .  BRIDGE
line   BRIDGE2  BRIDGE2  .  BRIDGE2
section B
line   B  B  .  B
line   B2 B2  .  B2
line   B3 B3  .  B3
line   B4 B4  .  B4
section B
line   B  B  .  B
line   B2 B2  .  B2
line   B3 B3  .  B3
line   B4 B4  .  B4
section END
line   END  END  .  END
end
