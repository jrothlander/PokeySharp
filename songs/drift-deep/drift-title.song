# DRIFT TITLE DEEP
# The title screen: New song's Chill style as it comes, in B flat - a broken chord over long
# roots and a half-time beat, from the minor chord; the chorus takes the Royal Road with an
# octave bass.
# DRIFT, a chill suite for one game: TITLE, CAFE, FIELD, RAIN, NIGHT, VICTORY, GAME OVER and
# CREDITS. All in B flat major or its relative G minor, laid-back, on one set of
# instruments. The title is New song's Chill style with its defaults, in B flat. The bass
# throughout is SOFTBASS, a pure tone, in place of the buzz.
# THIS COPY has the 16-bit DEEPBASS on channels 1+2 in place of SOFTBASS, to compare. To
# make room: the drums on channel 1.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Style: Chill - a laid-back loop.
# Chords: vi IV I V:  Gm Eb Bb F; in B, IV V iii vi:  Eb F Dm Gm.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   DRIFT TITLE DEEP
key    B FLAT MAJOR

# A deep bass, low and soft - 16-bit, in tune all the way down.
instrument DEEPBASS
  table      wide
  volume     10 10 9 9 8 8 8 7 7 7 6 6 6 5
  distortion tone
  release    3

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Soft keys for an accompaniment: struck, then falling away.
instrument KEYS
  table      tone
  volume     11 10 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    3

channel 1 pair LOW BYTE
  note  The low byte of channel 2's 16-bit divider.

channel 2 notes BASS
  note  Bass: roots, on the chords' roots.
  voice DEEPBASS
  track INTRO G2 . . .  . . . .  F2 . . .  . . . .
  track INTRO2 Eb2 . . .  . . . .  F2 . . .  . . . .
  track A      G2 . . .  G2 . . .  G2 . . .  F2 . . .
  track A2     Eb2 . . .  Eb2 . . .  Eb2 . . .  C2 . . .
  track A3     Bb2 . . .  Bb2 . . .  Bb2 . . .  G2 . . .
  track A4     F2 . . .  F2 . . .  F2 . . .  F2 . . .
  track B      Eb2 . Eb3 .  Eb2 . Eb3 .  Eb2 . Eb3 .  Eb2 . Eb3 .
  track B2     F2 . F3 .  F2 . F3 .  F2 . F3 .  F2 . Eb2 .
  track B3     D2 . D3 .  D2 . D3 .  D2 . D3 .  D2 . F2 .
  track B4     G2 . G3 .  G2 . G3 .  F2 . F3 .  F2 . F3 .
  track BUILD  G2 . G2 .  G2 . G2 .  G2 . G2 .  G2 . F2 .
  track BUILD2 Eb2 . Eb2 .  Eb2 . Eb2 .  F2 . F2 .  F2 . F2 .

channel 3 notes LEAD
  note  Empty: the tune is yours.
  voice LEAD

channel 4 notes PATTERN
  note  Broken chord, up and back, on each chord.
  voice KEYS
  track INTRO G3 . Bb3 .  D4 . G4 .  Bb4 . G4 .  D4 . Bb3 .
  track INTRO2 Eb3 . G3 .  Bb3 . Eb4 .  A4 . F4 .  C4 . A3 .
  track A      G3 . Bb3 .  D4 . G4 .  Bb4 . G4 .  D4 . Bb3 .
  track A2     Eb3 . G3 .  Bb3 . Eb4 .  G4 . Eb4 .  Bb3 . G3 .
  track A3     Bb3 . D4 .  F4 . Bb4 .  D5 . Bb4 .  F4 . D4 .
  track A4     F3 . A3 .  C4 . F4 .  A4 . F4 .  C4 . A3 .
  track B      Eb3 . Bb3 .  G4 . Bb3 .  Eb3 . Bb3 .  G4 . Bb3 .
  track B2     F3 . C4 .  A4 . C4 .  F3 . C4 .  A4 . C4 .
  track B3     D4 . A4 .  F5 . A4 .  D4 . A4 .  F5 . A4 .
  track B4     G3 . D4 .  Bb4 . D4 .  F3 . C4 .  A4 . C4 .
  track BREAK  G3 . Bb3 .  D4 . G4 .  Bb4 . G4 .  D4 . Bb3 .
  track BREAK2 Eb3 . G3 .  Bb3 . Eb4 .  A4 . F4 .  C4 . A3 .
  track BUILD  G3 . Bb3 .  D4 . G4 .  Bb4 . G4 .  D4 . Bb3 .
  track BUILD2 Eb3 . G3 .  Bb3 . Eb4 .  A4 . F4 .  C4 . A3 .

# The order list: a section at a time.
audctl $50
speed  9
section INTRO
line   .  INTRO  .  INTRO
line   .  INTRO2  .  INTRO2
section A
loop
line   .  A  .  A
line   .  A2  .  A2
line   .  A3  .  A3
line   .  A4  .  A4
section B
line   .  B  .  B
line   .  B2  .  B2
line   .  B3  .  B3
line   .  B4  .  B4
section BREAK
line   .  .  .  BREAK
line   .  .  .  BREAK2
section BUILD
line   .  BUILD  .  BUILD
line   .  BUILD2  .  BUILD2
