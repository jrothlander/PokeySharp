# ANTHEM SKELETON
# A skeleton in a common musical-theatre anthem form: a quiet verse with no drums, a second
# verse, a pre-chorus building, a chorus bursting out; the quiet verse again, the pre-chorus,
# the chorus; a bridge and a build to the peak; the last choruses a whole step higher (C to D);
# an ending. Its story is told in the chords: the verses start on the minor chord (vi - IV - I
# - V) and sound held back, the chorus starts on the home chord (I - V - vi - IV) and opens up.
# Key, chords and tempo are this skeleton's own, not any song's; nothing of any song's music is
# here. Channel 3 is empty: keep the verse low and close, climb in the pre-chorus, and let the
# chorus melody reach its highest notes - then the lifted choruses take it higher still.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: vi IV I V:  Am F C G; in B, I V vi IV:  C G Am F.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   ANTHEM SKELETON
key    C MAJOR

# A soft, round bass: the pure tone, plucked and fading - no buzz, one channel, every note
# in tune from C3 up.
instrument SOFTBASS
  table      tone
  volume     12 11 10 9 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    2

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Soft keys for an accompaniment: struck, then falling away.
instrument KEYS
  table      tone
  volume     11 10 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    3

# Four drums: a falling thump, a burst of noise, and a short and a long hiss. Each is a
# table of registers a frame at a time, with no note table, so a key only says which drum.
instrument KICK
  table      none
  volume     15 13 10 7 4 2 0
  distortion buzz
  audf       40 55 70 85 100 115 130

instrument SNARE
  table      none
  volume     13 11 9 7 5 4 3 2 1 0
  distortion tone noise
  audf       50 8 9 10 11 12 13

instrument HAT
  table      none
  volume     8 5 3 1 0
  distortion noise
  audf       2

instrument OPEN
  table      none
  volume     8 7 6 5 4 3 2 2 1 1 0
  distortion noise
  audf       1

channel 1 drums DRUMS
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track A     K . H .  S . H .  K . K .  S . H .
  track A2    K . H .  S . H .  K . S .  S S S S
  track PRE   K . . .  S . . .  K . . .  S . . .
  track PRE2  S . S .  S . S .  S S S S  S S S S
  track B     K . O .  K . O .  K . O .  K . O .
  track B2    S . S .  S . S .  S S S S  S S S S
  track BRIDGE K . H .  H . H .  S . H .  H . H .
  track BRIDGE2 K . H .  S . H .  S . S S  S S S S
  track BUILD   K . S S  K . S .  K . S S  K . S S
  track BUILD2  S . S .  S . S .  S S S S  S S S S
  track LIFT    K . O .  K . O .  K . O .  K . O .
  track LIFT2   S . S .  S . S .  S S S S  S S S S
  track ENDUP   O . . .  . . . .  . . . .  . . . .

channel 2 notes BASS
  note  Each section's own bass line, on the chords' roots.
  voice SOFTBASS
  track QUIET A3 . . .  . . . .  . . . .  . . . .
  track QUIET2 F3 . . .  . . . .  . . . .  . . . .
  track QUIET3 C3 . . .  . . . .  . . . .  . . . .
  track QUIET4 G3 . . .  . . . .  . . . .  . . . .
  track A      A3 . . .  E4 . . .  A3 . . .  G3 . . .
  track A2     F3 . . .  C4 . . .  F3 . . .  D3 . . .
  track A3     C4 . . .  G4 . . .  C4 . . .  A3 . . .
  track A4     G3 . . .  D4 . . .  G3 . . .  D4 . . .
  track PRE    A3 . A4 .  A3 . A4 .  A3 . A4 .  A3 . G3 .
  track PRE2   F3 . F4 .  F3 . F4 .  G3 . G4 .  G3 . G4 .
  track B      C4 . C5 .  C4 . C5 .  C4 . C5 .  C4 . A3 .
  track B2     G3 . G4 .  G3 . G4 .  G3 . G4 .  G3 . G4 .
  track B3     A3 . A4 .  A3 . A4 .  A3 . A4 .  A3 . G3 .
  track B4     F3 . F4 .  F3 . F4 .  G3 . G4 .  G3 . B3 .
  track BRIDGE A3 . . .  . . . .  . . . .  . . . .
  track BRIDGE2 F3 . . .  . . . .  . . . .  . . . .
  track BUILD   A3 . A4 .  A3 . A4 .  A3 . A4 .  A3 . G3 .
  track BUILD2  F3 . F4 .  F3 . F4 .  G3 . G4 .  G3 . G4 .
  track LIFT    D3 . D4 .  D3 . D4 .  D3 . D4 .  D3 . B2 .
  track LIFT2   A3 . A4 .  A3 . A4 .  A3 . A4 .  A3 . A4 .
  track LIFT3   B3 . B4 .  B3 . B4 .  B3 . B4 .  B3 . A3 .
  track LIFT4   G3 . G4 .  G3 . G4 .  A3 . A4 .  A3 . C#4 .
  track ENDUP   D3 . . .  . . . .  . . . .  . . . .

channel 3 notes LEAD
  note  Empty: the tune is yours.
  voice LEAD
  track QUIET . . . .  . . . .  . . . .  . . . .
  track QUIET2 . . . .  . . . .  . . . .  . . . .
  track QUIET3 . . . .  . . . .  . . . .  . . . .
  track QUIET4 . . . .  . . . .  . . . .  . . . .
  track A      . . . .  . . . .  . . . .  . . . .
  track A2     . . . .  . . . .  . . . .  . . . .
  track A3     . . . .  . . . .  . . . .  . . . .
  track A4     . . . .  . . . .  . . . .  . . . .
  track PRE    . . . .  . . . .  . . . .  . . . .
  track PRE2   . . . .  . . . .  . . . .  . . . .
  track B      . . . .  . . . .  . . . .  . . . .
  track B2     . . . .  . . . .  . . . .  . . . .
  track B3     . . . .  . . . .  . . . .  . . . .
  track B4     . . . .  . . . .  . . . .  . . . .
  track BRIDGE . . . .  . . . .  . . . .  . . . .
  track BRIDGE2 . . . .  . . . .  . . . .  . . . .
  track BUILD   . . . .  . . . .  . . . .  . . . .
  track BUILD2  . . . .  . . . .  . . . .  . . . .
  track LIFT    . . . .  . . . .  . . . .  . . . .
  track LIFT2   . . . .  . . . .  . . . .  . . . .
  track LIFT3   . . . .  . . . .  . . . .  . . . .
  track LIFT4   . . . .  . . . .  . . . .  . . . .
  track ENDUP   . . . .  . . . .  . . . .  . . . .

channel 4 notes PATTERN
  note  Broken chord, up and back, on each chord.
  voice KEYS
  track QUIET A3 . C4 .  E4 . A4 .  C5 . A4 .  E4 . C4 .
  track QUIET2 F3 . A3 .  C4 . F4 .  A4 . F4 .  C4 . A3 .
  track QUIET3 C4 . E4 .  G4 . C5 .  E5 . C5 .  G4 . E4 .
  track QUIET4 G3 . B3 .  D4 . G4 .  B4 . G4 .  D4 . B3 .
  track A      A3 . C4 .  E4 . A4 .  C5 . A4 .  E4 . C4 .
  track A2     F3 . A3 .  C4 . F4 .  A4 . F4 .  C4 . A3 .
  track A3     C4 . E4 .  G4 . C5 .  E5 . C5 .  G4 . E4 .
  track A4     G3 . B3 .  D4 . G4 .  B4 . G4 .  D4 . B3 .
  track PRE    A3 . C4 .  E4 . A4 .  C5 . A4 .  E4 . C4 .
  track PRE2   F3 . A3 .  C4 . F4 .  B4 . G4 .  D4 . B3 .
  track B      C . . .  C . . .  C . . .  C . . .
  track B2     G . . .  G . . .  G . . .  G . . .
  track B3     Am . . .  Am . . .  Am . . .  Am . . .
  track B4     F . . .  F . . .  G . . .  G . . .
  track BRIDGE A3 . C4 .  E4 . A4 .  C5 . A4 .  E4 . C4 .
  track BRIDGE2 F3 . A3 .  C4 . F4 .  B4 . G4 .  D4 . B3 .
  track BUILD   A3 . C4 .  E4 . A4 .  C5 . A4 .  E4 . C4 .
  track BUILD2  F3 . A3 .  C4 . F4 .  B4 . G4 .  D4 . B3 .
  track LIFT    D . . .  D . . .  D . . .  D . . .
  track LIFT2   A . . .  A . . .  A . . .  A . . .
  track LIFT3   Bm . . .  Bm . . .  Bm . . .  Bm . . .
  track LIFT4   G . . .  G . . .  A . . .  A . . .
  track ENDUP   D4 . . .  . . . .  . . . .  . . . .

# The order list: a section at a time.
speed  7
section QUIET
line   .  QUIET  QUIET  QUIET
line   .  QUIET2  QUIET2  QUIET2
line   .  QUIET3  QUIET3  QUIET3
line   .  QUIET4  QUIET4  QUIET4
section A
line   A  A  A  A
line   A  A2  A2 A2
line   A  A3  A3 A3
line   A2  A4  A4 A4
section PRE
line   PRE  PRE  PRE  PRE
line   PRE2  PRE2  PRE2  PRE2
section B
line   B  B  B  B
line   B  B2  B2 B2
line   B  B3  B3 B3
line   B2  B4  B4 B4
section QUIET
line   .  QUIET  QUIET  QUIET
line   .  QUIET2  QUIET2  QUIET2
line   .  QUIET3  QUIET3  QUIET3
line   .  QUIET4  QUIET4  QUIET4
section PRE
line   PRE  PRE  PRE  PRE
line   PRE2  PRE2  PRE2  PRE2
section B
line   B  B  B  B
line   B  B2  B2 B2
line   B  B3  B3 B3
line   B2  B4  B4 B4
section BRIDGE
line   BRIDGE  BRIDGE  BRIDGE  BRIDGE
line   BRIDGE2  BRIDGE2  BRIDGE2  BRIDGE2
section BUILD
line   BUILD  BUILD  BUILD  BUILD
line   BUILD2  BUILD2  BUILD2  BUILD2
section LIFT
line   LIFT  LIFT  LIFT  LIFT
line   LIFT  LIFT2  LIFT2  LIFT2
line   LIFT  LIFT3  LIFT3  LIFT3
line   LIFT2  LIFT4  LIFT4  LIFT4
section LIFT
line   LIFT  LIFT  LIFT  LIFT
line   LIFT  LIFT2  LIFT2  LIFT2
line   LIFT  LIFT3  LIFT3  LIFT3
line   LIFT2  LIFT4  LIFT4  LIFT4
section ENDUP
line   ENDUP  ENDUP  ENDUP  ENDUP
end
