# RIFF POP SKELETON
# A skeleton in a common pop form: a riff that opens the song, returns after each chorus and
# carries the break; verse (A), a pre-chorus ramping into each chorus (B). One ii - V - I - IV
# loop in A major under everything, fast. Structure, chords, key and tempo are common property;
# nothing here is any song's melody or riff. Channel 3 is empty: write your riff in the RIFF
# lines and your tune in the rest - the chorus lifts by going higher, over the same chords.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: ii V I IV:  Bm E A D; in B, ii V I IV:  Bm E A D.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   RIFF POP SKELETON
key    A MAJOR

# A soft, round bass: the pure tone, plucked and fading - no buzz, one channel, every note
# in tune from C3 up.
instrument SOFTBASS
  table      tone
  volume     12 11 10 9 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    2

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Soft keys for an accompaniment: struck, then falling away.
instrument KEYS
  table      tone
  volume     11 10 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    3

# Four drums: a falling thump, a burst of noise, and a short and a long hiss. Each is a
# table of registers a frame at a time, with no note table, so a key only says which drum.
instrument KICK
  table      none
  volume     15 13 10 7 4 2 0
  distortion buzz
  audf       40 55 70 85 100 115 130

instrument SNARE
  table      none
  volume     13 11 9 7 5 4 3 2 1 0
  distortion tone noise
  audf       50 8 9 10 11 12 13

instrument HAT
  table      none
  volume     8 5 3 1 0
  distortion noise
  audf       2

instrument OPEN
  table      none
  volume     8 7 6 5 4 3 2 2 1 1 0
  distortion noise
  audf       1

channel 1 drums DRUMS
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track RIFF  K . H .  S . H .  K . K .  S . H .
  track RIFF2 K . H .  S . H .  K . S .  S S S S
  track A     K . H .  S . H .  K . K .  S . H .
  track A2    K . H .  S . H .  K . S .  S S S S
  track PRE   K . H .  S . H .  K . K .  S . H .
  track PRE2  S . S .  S . S .  S S S S  S S S S
  track B     K . H .  S . H .  K . K .  S . H .
  track B2    S . S .  S . S .  S S S S  S S S S
  track BREAK H H H H  H H H H  H H H H  H H H H

channel 2 notes BASS
  note  Each section's own bass line, on the chords' roots.
  voice SOFTBASS
  track RIFF  B3 . . .  F#4 . . .  B3 . . .  D4 . . .
  track RIFF2 E3 . . .  B3 . . .  E3 . . .  C#3 . . .
  track A     B3 . . .  F#4 . . .  B3 . . .  D4 . . .
  track A2    E3 . . .  B3 . . .  E3 . . .  G#3 . . .
  track A3    A3 . . .  E4 . . .  A3 . . .  C#4 . . .
  track A4    D3 . . .  A3 . . .  E3 . . .  C#3 . . .
  track PRE   B3 . B4 .  B3 . B4 .  B3 . B4 .  B3 . D4 .
  track PRE2  E3 . E4 .  E3 . E4 .  E3 . E4 .  E3 . C#3 .
  track B     B3 . B4 .  B3 . B4 .  B3 . B4 .  B3 . D4 .
  track B2    E3 . E4 .  E3 . E4 .  E3 . E4 .  E3 . G#3 .
  track B3    A3 . A4 .  A3 . A4 .  A3 . A4 .  A3 . C#4 .
  track B4    D3 . D4 .  D3 . D4 .  E3 . E4 .  E3 . C#3 .

channel 3 notes LEAD
  note  Empty: the tune is yours.
  voice LEAD
  track RIFF  . . . .  . . . .  . . . .  . . . .
  track RIFF2 . . . .  . . . .  . . . .  . . . .
  track A     . . . .  . . . .  . . . .  . . . .
  track A2    . . . .  . . . .  . . . .  . . . .
  track A3    . . . .  . . . .  . . . .  . . . .
  track A4    . . . .  . . . .  . . . .  . . . .
  track PRE   . . . .  . . . .  . . . .  . . . .
  track PRE2  . . . .  . . . .  . . . .  . . . .
  track B     . . . .  . . . .  . . . .  . . . .
  track B2    . . . .  . . . .  . . . .  . . . .
  track B3    . . . .  . . . .  . . . .  . . . .
  track B4    . . . .  . . . .  . . . .  . . . .
  track BREAK . . . .  . . . .  . . . .  . . . .
  track BREAK2 . . . .  . . . .  . . . .  . . . .

channel 4 notes CHORDS
  note  Arpeggio, going up, on each chord.
  voice KEYS
  track RIFF  B4 . D5 .  F#5 . B5 .  B4 . D5 .  F#5 . B5 .
  track RIFF2 E4 . G#4 .  B4 . E5 .  E4 . G#4 .  B4 . E5 .
  track A     B4 . D5 .  F#5 . B5 .  B4 . D5 .  F#5 . B5 .
  track A2    E4 . G#4 .  B4 . E5 .  E4 . G#4 .  B4 . E5 .
  track A3    E4 . A4 .  C#5 . E5 .  E4 . A4 .  C#5 . E5 .
  track A4    F#4 . A4 .  D5 . F#5 .  E4 . G#4 .  B4 . E5 .
  track PRE   B4 . D5 .  F#5 . B5 .  B4 . D5 .  F#5 . B5 .
  track PRE2  E4 . G#4 .  B4 . E5 .  E4 . G#4 .  B4 . E5 .
  track B     B4 . D5 .  F#5 . D5 .  B4 . D5 .  F#5 . D5 .
  track B2    E4 . G#4 .  B4 . G#4 .  E4 . G#4 .  B4 . G#4 .
  track B3    E4 . A4 .  C#5 . A4 .  E4 . A4 .  C#5 . A4 .
  track B4    F#4 . A4 .  D5 . A4 .  E4 . G#4 .  B4 . G#4 .
  track BREAK B4 . D5 .  F#5 . B5 .  B4 . D5 .  F#5 . B5 .
  track BREAK2 E4 . G#4 .  B4 . E5 .  E4 . G#4 .  B4 . E5 .

# The order list: a section at a time.
speed  5
section RIFF
line   RIFF  RIFF  RIFF  RIFF
line   RIFF2  RIFF2  RIFF2  RIFF2
section A
loop
line   A  A  A  A
line   A  A2  A2 A2
line   A  A3  A3 A3
line   A2  A4  A4 A4
section PRE
line   PRE  PRE  PRE  PRE
line   PRE2  PRE2  PRE2  PRE2
section B
line   B  B  B  B
line   B  B2  B2 B2
line   B  B3  B3 B3
line   B2  B4  B4 B4
section RIFF
line   RIFF  RIFF  RIFF  RIFF
line   RIFF2  RIFF2  RIFF2  RIFF2
section A
line   A  A  A  A
line   A  A2  A2 A2
line   A  A3  A3 A3
line   A2  A4  A4 A4
section PRE
line   PRE  PRE  PRE  PRE
line   PRE2  PRE2  PRE2  PRE2
section B
line   B  B  B  B
line   B  B2  B2 B2
line   B  B3  B3 B3
line   B2  B4  B4 B4
section BREAK
line   BREAK  .  BREAK  BREAK
line   BREAK  .  BREAK2  BREAK2
section B
line   B  B  B  B
line   B  B2  B2 B2
line   B  B3  B3 B3
line   B2  B4  B4 B4
