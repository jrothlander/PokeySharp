# LANTERN JOURNEY
# THIS COPY HAS A LEAD MELODY ON CHANNEL 3, WRITTEN BY CLAUDE AS AN EXAMPLE of what could go
# there. It is not Greg's writing. The accompaniment is the same as in songs/lantern/.
# The road between places: the pop progression, an open-tenth pattern over a half-time beat;
# the chorus takes the Royal Road.
# LANTERN, a ballad suite for one game: TITLE, VILLAGE, JOURNEY, MEMORY, NIGHT, VICTORY,
# GAME OVER and CREDITS. All in C major or its relative A minor, piano-led, on one set of
# instruments. The title is New song's Ballad style with its defaults.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: I V vi IV:  C G Am F; in B, IV V iii vi:  F G Em Am.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   LANTERN JOURNEY
key    C MAJOR

# Distortion C, for a bass. Its table skips notes - see which in the tracker's colours.
instrument BASS
  table      buzz
  volume     12 11 10 9 8
  distortion buzz
  release    3

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Soft keys for an accompaniment: struck, then falling away.
instrument KEYS
  table      tone
  volume     11 10 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    3

# Four drums: a falling thump, a burst of noise, and a short and a long hiss. Each is a
# table of registers a frame at a time, with no note table, so a key only says which drum.
instrument KICK
  table      none
  volume     15 13 10 7 4 2 0
  distortion buzz
  audf       40 55 70 85 100 115 130

instrument SNARE
  table      none
  volume     13 11 9 7 5 4 3 2 1 0
  distortion tone noise
  audf       50 8 9 10 11 12 13

instrument HAT
  table      none
  volume     8 5 3 1 0
  distortion noise
  audf       2

instrument OPEN
  table      none
  volume     8 7 6 5 4 3 2 2 1 1 0
  distortion noise
  audf       1

channel 1 drums DRUMS
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track INTRO K . H .  H . H .  S . H .  H . H .
  track INTRO2 K . H .  S . H .  K . S .  S S S S
  track A      K . H .  H . H .  S . H .  H . H .
  track A2     K . H .  S . H .  K . S .  S S S S
  track B      K . . .  S . . .  K . . .  S . . .
  track B2     S . S .  S . S .  S S S S  S S S S

channel 2 notes BASS
  note  Bass: roots, on the chords' roots.
  voice BASS
  track INTRO C1 . . .  . . . .  A1 . . .  . . . .
  track INTRO2 G2 . . .  . . . .  D3 . . .  . . . .
  track A      C1 . . .  C1 . . .  C1 . . .  A1 . . .
  track A2     G2 . . .  G2 . . .  G2 . . .  G2 . . .
  track A3     A1 . . .  A1 . . .  A1 . . .  G1 . . .
  track A4     F2 . . .  F2 . . .  G2 . . .  D3 . . .
  track B      F1 . C1 .  F1 . C1 .  F1 . C1 .  F1 . C1 .
  track B2     G2 . D3 .  G2 . D3 .  G2 . D3 .  G2 . F2 .
  track B3     E2 . E2 .  E2 . E2 .  E2 . E2 .  E2 . G2 .
  track B4     A1 . E2 .  A1 . E2 .  G1 . D2 .  G1 . D2 .

channel 3 notes LEAD
  note  An example lead melody, written by Claude - not Greg's. The tracks are named M + the section's chord track.
  voice LEAD
  track MA E4 . G4 .  C5 . . .  E5 . D5 .  C5 . . .
  track MA2 B4 . . .  G4 . . .  D5 . . .  . . . .
  track MA3 C5 . . .  A4 . . .  E5 . . .  . . C5 .
  track MA4 A4 . . .  F4 . . .  G4 . . .  . . - .
  track MB  A4 . C5 .  F5 . . .  C5 . . .  A4 . . .
  track MB2 B4 . D5 .  G5 . . .  D5 . . .  B4 . . .
  track MB3 B4 . G4 .  E5 . . .  B4 . . .  G4 . . .
  track MB4 A4 . . .  C5 . . .  B4 . . .  . . - .

channel 4 notes PATTERN
  note  1-5-10, the open tenth, on each chord.
  voice KEYS
  track INTRO C4 . G4 .  E5 . G4 .  C4 . G4 .  E5 . G4 .
  track INTRO2 G3 . D4 .  B4 . D4 .  G3 . D4 .  B4 . D4 .
  track A      C4 . G4 .  E5 . G4 .  C4 . G4 .  E5 . G4 .
  track A2     G3 . D4 .  B4 . D4 .  G3 . D4 .  B4 . D4 .
  track A3     A3 . E4 .  C5 . E4 .  A3 . E4 .  C5 . E4 .
  track A4     F3 . C4 .  A4 . C4 .  G3 . D4 .  B4 . D4 .
  track B      F3 . A3 .  C4 . F4 .  A4 . F4 .  C4 . A3 .
  track B2     G3 . B3 .  D4 . G4 .  B4 . G4 .  D4 . B3 .
  track B3     E4 . G4 .  B4 . E5 .  G5 . E5 .  B4 . G4 .
  track B4     A3 . C4 .  E4 . A4 .  B4 . G4 .  D4 . B3 .

# The order list: a section at a time.
speed  8
section INTRO
line   INTRO  INTRO  .  INTRO
line   INTRO2  INTRO2  .  INTRO2
section A
loop
line   A  A  MA A
line   A  A2  MA2  A2
line   A  A3  MA3  A3
line   A2  A4  MA4  A4
section B
line   B  B  MB B
line   B  B2  MB2  B2
line   B  B3  MB3  B3
line   B2  B4  MB4  B4
