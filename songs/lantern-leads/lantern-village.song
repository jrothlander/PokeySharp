# LANTERN VILLAGE
# THIS COPY HAS A LEAD MELODY ON CHANNEL 3, WRITTEN BY CLAUDE AS AN EXAMPLE of what could go
# there. It is not Greg's writing. The accompaniment is the same as in songs/lantern/.
# The village or hub: a gentle waltz, oom-pah-pah on soft keys; the chorus rolls an arpeggio
# round the circle of fifths.
# LANTERN, a ballad suite for one game: TITLE, VILLAGE, JOURNEY, MEMORY, NIGHT, VICTORY,
# GAME OVER and CREDITS. All in C major or its relative A minor, piano-led, on one set of
# instruments. The title is New song's Ballad style with its defaults.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: I IV V I:  C F G C; in B, vi ii V I:  Am Dm G C.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   LANTERN VILLAGE
key    C MAJOR
rows   12
beat   4

# Distortion C, for a bass. Its table skips notes - see which in the tracker's colours.
instrument BASS
  table      buzz
  volume     12 11 10 9 8
  distortion buzz
  release    3

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Soft keys for an accompaniment: struck, then falling away.
instrument KEYS
  table      tone
  volume     11 10 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    3

# Four drums: a falling thump, a burst of noise, and a short and a long hiss. Each is a
# table of registers a frame at a time, with no note table, so a key only says which drum.
instrument KICK
  table      none
  volume     15 13 10 7 4 2 0
  distortion buzz
  audf       40 55 70 85 100 115 130

instrument SNARE
  table      none
  volume     13 11 9 7 5 4 3 2 1 0
  distortion tone noise
  audf       50 8 9 10 11 12 13

instrument HAT
  table      none
  volume     8 5 3 1 0
  distortion noise
  audf       2

instrument OPEN
  table      none
  volume     8 7 6 5 4 3 2 2 1 1 0
  distortion noise
  audf       1

channel 1 drums DRUMS
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track INTRO K . . .  S . . .  S . . .
  track INTRO2 K . H .  S . S .  S S S S
  track A      K . . .  S . . .  S . . .
  track A2     K . H .  S . S .  S S S S
  track B      K . H .  S . H .  S . H .
  track B2     K . H .  S . S .  S S S S
  track BRIDGE K . . .  S . . .  S . . .
  track BRIDGE2 K . H .  S . S .  S S S S

channel 2 notes BASS
  note  Bass: roots, on the chords' roots.
  voice BASS
  track INTRO C1 . . .  . . . .  E1 . . .
  track INTRO2 F2 . . .  . . . .  G2 . . .
  track A      C1 . . .  C1 . . .  E1 . . .
  track A2     F2 . . .  F2 . . .  F2 . . .
  track A3     G2 . . .  G2 . . .  B2 . . .
  track A4     C1 . . .  A1 . . .  G2 . . .
  track B      A1 . A1 .  A1 . A1 .  A1 . C1 .
  track B2     D2 . D2 .  D2 . D2 .  D2 . F2 .
  track B3     G2 . G2 .  G2 . G2 .  G2 . B2 .
  track B4     C1 . C1 .  A1 . G2 .  G2 . G2 .
  track BRIDGE C1 . . .  . . . .  . . . .
  track BRIDGE2 F2 . . .  . . . .  . . . .

channel 3 notes LEAD
  note  An example lead melody, written by Claude - not Greg's. The tracks are named M + the section's chord track.
  voice LEAD
  track MA G4 . . .  C5 . . .  E5 . . .
  track MA2 F5 . . .  E5 . . .  C5 . . .
  track MA3 D5 . . .  B4 . . .  G4 . . .
  track MA4 C5 . . .  E5 . D5 .  B4 . . .
  track MB  A4 . . .  C5 . . .  E5 . . .
  track MB2 D5 . . .  F5 . . .  A5 . . .
  track MB3 G5 . . .  D5 . . .  B4 . . .
  track MB4 C5 . . .  G4 . B4 .  D5 . . -
  track MBRIDGE E5 . . .  . . . .  . . . .
  track MBRIDGE2 F5 . . .  . . D5 .  . . . -

channel 4 notes PATTERN
  note  Oom-pah-pah (waltz), on each chord.
  voice KEYS
  track INTRO C4 . . .  C . . .  C . . .
  track INTRO2 F3 . . .  F . G3 .  G . . .
  track A      C4 . . .  C . . .  C . . .
  track A2     F3 . . .  F . . .  F . . .
  track A3     G3 . . .  G . . .  G . . .
  track A4     C4 . . .  C . G3 .  G . . .
  track B      A3 . E4 .  A4 . C5 .  A4 . E4 .
  track B2     D4 . A4 .  D5 . F5 .  D5 . A4 .
  track B3     G3 . D4 .  G4 . B4 .  G4 . D4 .
  track B4     C4 . G4 .  C5 . B4 .  G4 . D4 .
  track BRIDGE C4 . . .  C . . .  C . . .
  track BRIDGE2 F3 . . .  F . G3 .  G . . .

# The order list: a section at a time.
speed  8
section INTRO
line   INTRO  INTRO  .  INTRO
line   INTRO2  INTRO2  .  INTRO2
section A
loop
line   A  A  MA A
line   A  A2  MA2  A2
line   A  A3  MA3  A3
line   A2  A4  MA4  A4
section B
line   B  B  MB B
line   B  B2  MB2  B2
line   B  B3  MB3  B3
line   B2  B4  MB4  B4
section A
line   A  A  MA A
line   A  A2  MA2  A2
line   A  A3  MA3  A3
line   A2  A4  MA4  A4
section BRIDGE
line   BRIDGE  BRIDGE  MBRIDGE  BRIDGE
line   BRIDGE2  BRIDGE2  MBRIDGE2  BRIDGE2
