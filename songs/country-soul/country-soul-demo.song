# COUNTRY SOUL DEMO
# THIS COPY HAS A LEAD MELODY ON CHANNEL 3, WRITTEN BY CLAUDE AS AN EXAMPLE of what could go
# there. It is not Greg's writing. Everything else is country-soul-skeleton.song unchanged.
# The lead follows the skeleton's own brief: a low, talky verse that circles G# and B with
# repeated notes, a chorus that climbs from B4 to a held B5 and lets its long notes ring (B5,
# not G#5: on the tone table G#5 is 22 cents sharp, and every note here is in tune), a sparse
# bridge, and a solo built on the G# minor pentatonic with the blue note (D natural) and
# runs in the twelve-eight triplets. All of it is written for this skeleton's chords; none of
# it is any song's.
#
# A country-soul skeleton: the character of a mid-2020s bluesy country ballad - a slow
# twelve-eight sway (four beats of three), a dark minor key, a shuffle on the drums, a
# root-and-fifth bass, rolling keys in the verses and chords on every beat in the choruses - in
# the power-ballad-with-a-solo form: intro, a hushed first verse, the band in for the second,
# chorus, verse, chorus, a bridge, a guitar-style solo, the chorus twice, an ending. G# minor at
# about 70 BPM. The chords are this skeleton's own (verse i - VI - VII - i: G#m E F# G#m; chorus
# VI - III - VII - i: E B F# G#m), not any song's; nothing of any song's music is here. Channel 3
# is empty for your tune: a low, talky verse and a chorus that climbs and holds its long notes,
# and a solo of your own in SOLO.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: i VI VII i:  G#m E F# G#m; in B, VI III VII i:  E B F# G#m.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   COUNTRY SOUL DEMO
key    G# MINOR
rows   12
beat   3

# A soft, round bass: the pure tone, plucked and fading - no buzz, one channel, every note
# in tune from C3 up.
instrument SOFTBASS
  table      tone
  volume     12 11 10 9 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    2

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Soft keys for an accompaniment: struck, then falling away.
instrument KEYS
  table      tone
  volume     11 10 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    3

# Four drums: a falling thump, a burst of noise, and a short and a long hiss. Each is a
# table of registers a frame at a time, with no note table, so a key only says which drum.
instrument KICK
  table      none
  volume     15 13 10 7 4 2 0
  distortion buzz
  audf       40 55 70 85 100 115 130

instrument SNARE
  table      none
  volume     13 11 9 7 5 4 3 2 1 0
  distortion tone noise
  audf       50 8 9 10 11 12 13

instrument HAT
  table      none
  volume     8 5 3 1 0
  distortion noise
  audf       2

instrument OPEN
  table      none
  volume     8 7 6 5 4 3 2 2 1 1 0
  distortion noise
  audf       1

channel 1 drums DRUMS
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track INTRO K . H  S . H  K . K  S . H
  track INTRO2 K . .  S . .  S S S  S S S
  track A      K . H  S . H  K . K  S . H
  track A2     K . .  S . .  S S S  S S S
  track B      K . H  S . H  K . K  S . H
  track B2     K . .  S . .  S S S  S S S
  track BRIDGE K . H  S . H  K . K  S . H
  track BRIDGE2 K . .  S . .  S S S  S S S
  track SOLO    K . H  S . H  K . K  S . H
  track SOLO2   K . .  S . .  S S S  S S S
  track END     O . .  . . .  . . .  . . .

channel 2 notes BASS
  note  Bass: root and fifth, on the chords' roots.
  voice SOFTBASS
  track INTRO G#3 . .  . . .  F#3 . .  . . .
  track INTRO2 E3 . .  . . .  D#3 . .  . . .
  track QUIET  G#3 . .  . . .  . . .  . . .
  track QUIET2 E3 . .  . . .  . . .  . . .
  track QUIET3 F#3 . .  . . .  . . .  . . .
  track A      G#3 . .  D#4 . .  G#3 . .  F#3 . .
  track A2     E3 . .  B3 . .  E3 . .  B3 . .
  track A3     F#3 . .  C#4 . .  F#3 . .  C#4 . .
  track A4     G#3 . .  E3 . .  D#3 . .  F#3 . .
  track B      E3 . B3  . E3 .  B3 . E3  . C#3 .
  track B2     B3 . F#4  . B3 .  F#4 . B3  . G#3 .
  track B3     F#3 . C#4  . F#3 .  C#4 . F#3  . C#4 .
  track B4     G#3 . D#4  . C#4 .  D#3 . A#3  . F#3 .
  track BRIDGE G#3 . .  . . .  . . .  . . .
  track BRIDGE2 E3 . .  . . .  . . .  . . .
  track SOLO    G#3 . D#4  . G#3 .  D#4 . G#3  . F#3 .
  track SOLO2   E3 . B3  . E3 .  B3 . E3  . B3 .
  track SOLO3   F#3 . C#4  . F#3 .  C#4 . F#3  . C#4 .
  track SOLO4   G#3 . D#4  . C#4 .  D#3 . A#3  . D#3 .
  track END     G#3 . .  . . .  . . .  . . .

channel 3 notes LEAD
  note  An example lead melody, written by Claude - not Greg's.
  voice LEAD
  track INTRO . . .  . . .  . . D#5  B4 . G#4
  track INTRO2 G#4 . .  . . B4  A#4 . .  . . -
  track QUIET  . . G#4  B4 . B4  B4 . A#4  G#4 . .
  track QUIET2 . . G#4  B4 . B4  C#5 . B4  G#4 . E4
  track QUIET3 . . F#4  A#4 . A#4  C#5 . A#4  F#4 . .
  track QUIET4 G#4 . .  . . .  A#4 . .  . . -
  track A      . . G#4  B4 . B4  B4 . A#4  G#4 . .
  track A2     . . G#4  B4 . B4  C#5 . B4  G#4 . E4
  track A3     . . F#4  A#4 . A#4  C#5 . A#4  F#4 . .
  track A4     D#5 . C#5  B4 . G#4  A#4 . .  . . -
  track B      . . B4  E5 . .  . . .  D#5 . B4
  track B2     D#5 . .  . . .  F#5 . .  . . D#5
  track B3     C#5 . .  . . .  A#4 . C#5  F#5 . .
  track B4     B5 . .  . . .  A#5 . .  . . -
  track BRIDGE D#5 . .  B4 . .  G#4 . .  B4 . .
  track BRIDGE2 C#5 . .  B4 . .  A#4 . .  . . -
  track SOLO    G#4 B4 C#5  D5 D#5 .  F#5 . D#5  B4 . G#4
  track SOLO2   B4 . E5  B5 . F#5  E5 . D#5  B4 . G#4
  track SOLO3   A#4 C#5 F#5  . . E5  F#5 . C#5  A#4 . F#4
  track SOLO4   G#4 B4 D#5  F#5 . B5  A#5 F#5 D#5  A#4 . .
  track END     G#4 . .  . . .  . . .  . . .

channel 4 notes PATTERN
  note  Rolling 1-5-8-10, up and back, on each chord.
  voice KEYS
  track INTRO G#3 D#4 G#4  B4 G#4 D#4  G#3 D#4 G#4  B4 G#4 D#4
  track INTRO2 E3 B3 E4  G#4 E4 B3  D#3 A#3 D#4  F#4 D#4 A#3
  track QUIET  G#3 D#4 G#4  B4 G#4 D#4  G#3 D#4 G#4  B4 G#4 D#4
  track QUIET2 E3 B3 E4  G#4 E4 B3  E3 B3 E4  G#4 E4 B3
  track QUIET3 F#3 C#4 F#4  A#4 F#4 C#4  F#3 C#4 F#4  A#4 F#4 C#4
  track QUIET4 G#3 D#4 G#4  B4 G#4 D#4  D#3 A#3 D#4  F#4 D#4 A#3
  track A      G#3 D#4 G#4  B4 G#4 D#4  G#3 D#4 G#4  B4 G#4 D#4
  track A2     E3 B3 E4  G#4 E4 B3  E3 B3 E4  G#4 E4 B3
  track A3     F#3 C#4 F#4  A#4 F#4 C#4  F#3 C#4 F#4  A#4 F#4 C#4
  track A4     G#3 D#4 G#4  B4 G#4 D#4  D#3 A#3 D#4  F#4 D#4 A#3
  track B      E . .  E . .  E . .  E . .
  track B2     B . .  B . .  B . .  B . .
  track B3     F# . .  F# . .  F# . .  F# . .
  track B4     G#m . .  G#m . .  D#m . .  D#m . .
  track BRIDGE G#3 D#4 G#4  B4 G#4 D#4  G#3 D#4 G#4  B4 G#4 D#4
  track BRIDGE2 E3 B3 E4  G#4 E4 B3  D#3 A#3 D#4  F#4 D#4 A#3
  track SOLO    G#3 D#4 G#4  B4 G#4 D#4  G#3 D#4 G#4  B4 G#4 D#4
  track SOLO2   E3 B3 E4  G#4 E4 B3  E3 B3 E4  G#4 E4 B3
  track SOLO3   F#3 C#4 F#4  A#4 F#4 C#4  F#3 C#4 F#4  A#4 F#4 C#4
  track SOLO4   G#3 D#4 G#4  B4 G#4 D#4  D#3 A#3 D#4  F#4 D#4 A#3
  track END     G#3 . .  . . .  . . .  . . .

# The order list: a section at a time.
speed  17
section INTRO
line   INTRO  INTRO  INTRO  INTRO
line   INTRO2  INTRO2  INTRO2  INTRO2
section QUIET
line   .  QUIET  QUIET  QUIET
line   .  QUIET2  QUIET2  QUIET2
line   .  QUIET3  QUIET3  QUIET3
line   .  QUIET  QUIET4  QUIET4
section A
line   A  A  A  A
line   A  A2  A2 A2
line   A  A3  A3 A3
line   A2  A4  A4 A4
section B
line   B  B  B  B
line   B  B2  B2 B2
line   B  B3  B3 B3
line   B2  B4  B4 B4
section A
line   A  A  A  A
line   A  A2  A2 A2
line   A  A3  A3 A3
line   A2  A4  A4 A4
section B
line   B  B  B  B
line   B  B2  B2 B2
line   B  B3  B3 B3
line   B2  B4  B4 B4
section BRIDGE
line   BRIDGE  BRIDGE  BRIDGE  BRIDGE
line   BRIDGE2  BRIDGE2  BRIDGE2  BRIDGE2
section SOLO
line   SOLO  SOLO  SOLO  SOLO
line   SOLO  SOLO2  SOLO2  SOLO2
line   SOLO  SOLO3  SOLO3  SOLO3
line   SOLO2  SOLO4  SOLO4  SOLO4
section B
line   B  B  B  B
line   B  B2  B2 B2
line   B  B3  B3 B3
line   B2  B4  B4 B4
section B
line   B  B  B  B
line   B  B2  B2 B2
line   B  B3  B3 B3
line   B2  B4  B4 B4
section END
line   END  END  END  END
end
