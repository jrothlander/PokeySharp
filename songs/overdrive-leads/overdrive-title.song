# OVERDRIVE TITLE
# THIS COPY HAS A LEAD MELODY ON CHANNEL 1, WRITTEN BY CLAUDE AS AN EXAMPLE of what could go
# there. It is not Greg's writing. The accompaniment is the same as in songs/overdrive/.
# The title screen: stately, no drums, a 16-bit piano sweeping the stage's chords; the
# chorus descends.
# OVERDRIVE, a suite for one game: TITLE, STAGE, BOSS, CALM, DUNGEON, VICTORY, GAME OVER and
# CREDITS. All in F# minor or its relative A major, on one set of instruments, so the cues
# sound like one game. The stage's chords, i - VI - III - VII, open the title too.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: i VI III VII:  F#m D A E; in B, i VII VI v:  F#m E D C#m.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   OVERDRIVE TITLE
key    F# MINOR

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Distortion C, for a bass. Its table skips notes - see which in the tracker's colours.
instrument BASS
  table      buzz
  volume     12 11 10 9 8
  distortion buzz
  release    3

# A piano: struck, falling away, and holding softly - 16-bit, so every note is within two cents.
instrument PIANO
  table      wide
  volume     13 12 11 10 10 9 9 8 8 7 7 6 6 5 5 5 4 4 4 3
  distortion tone
  release    3

channel 1 notes LEAD
  note  An example lead melody, written by Claude - not Greg's. The tracks are named M + the section's chord track.
  voice LEAD
  track MA F#4 . . .  A4 . . .  C#5 . . .  . . . .
  track MA2 A4 . . .  D5 . . .  . . . .  C#5 . A4 .
  track MA3 C#5 . . .  E5 . . .  A4 . . .  C#5 . . .
  track MA4 B4 . . .  G#4 . . .  G#4 . . .  . . . .
  track MB  C#5 . . .  . . B4 .  A4 . . .  F#4 . . .
  track MB2 G#4 . . .  . . A4 .  B4 . . .  E5 . . .
  track MB3 D5 . . .  . . C#5 .  A4 . . .  F#4 . . .
  track MB4 E4 . . .  G#4 . . .  C#5 . . .  . . - .

channel 2 notes BASS
  note  Bass: roots, on the chords' roots.
  voice BASS
  track INTRO F#2 . . .  . . . .  E2 . . .  . . . .
  track INTRO2 D2 . . .  . . . .  C#2 . . .  . . . .
  track A      F#2 . . .  F#2 . . .  F#2 . . .  E2 . . .
  track A2     D2 . . .  D2 . . .  D2 . . .  G#1 . . .
  track A3     A1 . . .  A1 . . .  A1 . . .  F#1 . . .
  track A4     E2 . . .  D2 . . .  C#2 . . .  E2 . . .
  track B      F#2 . F#2 .  F#2 . F#2 .  F#2 . F#2 .  F#2 . F#2 .
  track B2     E2 . E2 .  E2 . E2 .  E2 . E2 .  E2 . E2 .
  track B3     D2 . D2 .  D2 . D2 .  D2 . D2 .  D2 . D2 .
  track B4     C#2 . C#2 .  C#2 . C#2 .  C#2 . C#2 .  C#2 . E2 .

channel 3 pair LOW BYTE
  note  The low byte of channel 4's 16-bit divider.

channel 4 notes PATTERN
  note  Broken chord, up and back, on each chord.
  voice PIANO
  track INTRO F#3 . A3 .  C#4 . F#4 .  A4 . F#4 .  C#4 . A3 .
  track INTRO2 D3 . F#3 .  A3 . D4 .  E4 . C#4 .  G#3 . E3 .
  track A      F#3 . A3 .  C#4 . F#4 .  A4 . F#4 .  C#4 . A3 .
  track A2     D3 . F#3 .  A3 . D4 .  F#4 . D4 .  A3 . F#3 .
  track A3     A3 . C#4 .  E4 . A4 .  C#5 . A4 .  E4 . C#4 .
  track A4     E3 . G#3 .  B3 . E4 .  E4 . C#4 .  G#3 . E3 .
  track B      F#3 A3 C#4 F#4  A4 C#5 F#5 A5  F#5 C#5 A4 F#4  C#4 A3 F#3 .
  track B2     E3 G#3 B3 E4  G#4 B4 E5 G#5  E5 B4 G#4 E4  B3 G#3 E3 .
  track B3     D3 F#3 A3 D4  F#4 A4 D5 F#5  D5 A4 F#4 D4  A3 F#3 D3 .
  track B4     C#3 E3 G#3 C#4  E4 G#4 C#5 E5  C#5 G#4 E4 C#4  G#3 E3 C#3 .

# The order list: a section at a time.
audctl $28
speed  8
section INTRO
line   .  INTRO  .  INTRO
line   .  INTRO2  .  INTRO2
section A
loop
line   MA A  .  A
line   MA2  A2  .  A2
line   MA3  A3  .  A3
line   MA4  A4  .  A4
section B
line   MB B  .  B
line   MB2  B2  .  B2
line   MB3  B3  .  B3
line   MB4  B4  .  B4
