# OVERDRIVE CREDITS
# THIS COPY HAS A LEAD MELODY ON CHANNEL 3, WRITTEN BY CLAUDE AS AN EXAMPLE of what could go
# there. It is not Greg's writing. The accompaniment is the same as in songs/overdrive/.
# The credits: warm and in six-eight, the relative major rolling 1-5-8-10 on soft keys; the
# chorus goes round the circle of fifths. Plays once and ends.
# OVERDRIVE, a suite for one game: TITLE, STAGE, BOSS, CALM, DUNGEON, VICTORY, GAME OVER and
# CREDITS. All in F# minor or its relative A major, on one set of instruments, so the cues
# sound like one game. The stage's chords, i - VI - III - VII, open the title too.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: I vi IV V:  A F#m D E; in B, vi ii V I:  F#m Bm E A.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   OVERDRIVE CREDITS
key    A MAJOR
rows   12
beat   3

# Distortion C, for a bass. Its table skips notes - see which in the tracker's colours.
instrument BASS
  table      buzz
  volume     12 11 10 9 8
  distortion buzz
  release    3

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Soft keys for an accompaniment: struck, then falling away.
instrument KEYS
  table      tone
  volume     11 10 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    3

# Four drums: a falling thump, a burst of noise, and a short and a long hiss. Each is a
# table of registers a frame at a time, with no note table, so a key only says which drum.
instrument KICK
  table      none
  volume     15 13 10 7 4 2 0
  distortion buzz
  audf       40 55 70 85 100 115 130

instrument SNARE
  table      none
  volume     13 11 9 7 5 4 3 2 1 0
  distortion tone noise
  audf       50 8 9 10 11 12 13

instrument HAT
  table      none
  volume     8 5 3 1 0
  distortion noise
  audf       2

instrument OPEN
  table      none
  volume     8 7 6 5 4 3 2 2 1 1 0
  distortion noise
  audf       1

channel 1 drums DRUMS
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track INTRO K . H  S . H  K . H  S . H
  track INTRO2 K . .  S . .  S S S  S S S
  track A      K . H  S . H  K . H  S . H
  track A2     K . .  S . .  S S S  S S S
  track B      K . H  S . H  K . H  S . H
  track B2     K . .  S . .  S S S  S S S
  track END    O . .  . . .  . . .  . . .

channel 2 notes BASS
  note  Bass: roots, on the chords' roots.
  voice BASS
  track INTRO A1 . .  . . .  G#1 . .  . . .
  track INTRO2 F#2 . .  . . .  E2 . .  . . .
  track A      A1 . .  A1 . .  A1 . .  G#1 . .
  track A2     F#2 . .  F#2 . .  F#2 . .  E2 . .
  track A3     D2 . .  D2 . .  D2 . .  D2 . .
  track A4     E2 . .  E2 . .  E2 . .  G#2 . .
  track B      F#1 . F#1  . F#1 .  F#1 . F#1  . A1 .
  track B2     B2 . B2  . B2 .  B2 . B2  . D3 .
  track B3     E2 . E2  . E2 .  E2 . E2  . G#2 .
  track B4     A1 . A1  . F#1 .  E1 . E1  . E1 .
  track END    A1 . .  . . .  . . .  . . .

channel 3 notes LEAD
  note  An example lead melody, written by Claude - not Greg's. The tracks are named M + the section's chord track.
  voice LEAD
  track MA C#5 . .  . B4 A4  . . E4  . . .
  track MA2 F#4 . .  . A4 C#5  . . .  . . .
  track MA3 D5 . .  . C#5 B4  . . A4  . . .
  track MA4 G#4 . .  . A4 B4  . . .  . . -
  track MB  A4 . .  . C#5 F#5  . . E5  . . .
  track MB2 D5 . .  . C#5 B4  . . F#4  . . .
  track MB3 G#4 . .  . B4 E5  . . D5  . . .
  track MB4 C#5 . .  . A4 .  E4 . .  G#4 . -
  track MEND A4 . .  . . .  . . .  . . -

channel 4 notes PATTERN
  note  Rolling 1-5-8-10, up and back, on each chord.
  voice KEYS
  track INTRO A3 E4 A4  C#5 A4 E4  A3 E4 A4  C#5 A4 E4
  track INTRO2 F#3 C#4 F#4  A4 F#4 C#4  E3 B3 E4  G#4 E4 B3
  track A      A3 E4 A4  C#5 A4 E4  A3 E4 A4  C#5 A4 E4
  track A2     F#3 C#4 F#4  A4 F#4 C#4  F#3 C#4 F#4  A4 F#4 C#4
  track A3     D3 A3 D4  F#4 D4 A3  D3 A3 D4  F#4 D4 A3
  track A4     E3 B3 E4  G#4 E4 B3  E3 B3 E4  G#4 E4 B3
  track B      F#3 C#4 F#4  A4 F#4 C#4  F#3 C#4 F#4  A4 F#4 C#4
  track B2     B3 F#4 B4  D5 B4 F#4  B3 F#4 B4  D5 B4 F#4
  track B3     E3 B3 E4  G#4 E4 B3  E3 B3 E4  G#4 E4 B3
  track B4     A3 E4 A4  C#5 A4 E4  E3 B3 E4  G#4 E4 B3
  track END    A3 . .  . . .  . . .  . . .

# The order list: a section at a time.
speed  11
section INTRO
line   INTRO  INTRO  .  INTRO
line   INTRO2  INTRO2  .  INTRO2
section A
line   A  A  MA A
line   A  A2  MA2  A2
line   A  A3  MA3  A3
line   A2  A4  MA4  A4
section B
line   B  B  MB B
line   B  B2  MB2  B2
line   B  B3  MB3  B3
line   B2  B4  MB4  B4
section A
line   A  A  MA A
line   A  A2  MA2  A2
line   A  A3  MA3  A3
line   A2  A4  MA4  A4
section B
line   B  B  MB B
line   B  B2  MB2  B2
line   B  B3  MB3  B3
line   B2  B4  MB4  B4
section END
line   END  END  MEND  END
end
