# DRIFT TITLE
# THIS COPY HAS A LEAD MELODY ON CHANNEL 3, WRITTEN BY CLAUDE AS AN EXAMPLE of what could go
# there. It is not Greg's writing. The accompaniment is the same as in songs/drift/.
# The title screen: New song's Chill style as it comes, in B flat - a broken chord over long
# roots and a half-time beat, from the minor chord; the chorus takes the Royal Road with an
# octave bass.
# DRIFT, a chill suite for one game: TITLE, CAFE, FIELD, RAIN, NIGHT, VICTORY, GAME OVER and
# CREDITS. All in B flat major or its relative G minor, laid-back, on one set of
# instruments. The title is New song's Chill style with its defaults, in B flat.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Style: Chill - a laid-back loop.
# Chords: vi IV I V:  Gm Eb Bb F; in B, IV V iii vi:  Eb F Dm Gm.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   DRIFT TITLE
key    B FLAT MAJOR

# Distortion C, for a bass. Its table skips notes - see which in the tracker's colours.
instrument BASS
  table      buzz
  volume     12 11 10 9 8
  distortion buzz
  release    3

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Soft keys for an accompaniment: struck, then falling away.
instrument KEYS
  table      tone
  volume     11 10 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    3

# Four drums: a falling thump, a burst of noise, and a short and a long hiss. Each is a
# table of registers a frame at a time, with no note table, so a key only says which drum.
instrument KICK
  table      none
  volume     15 13 10 7 4 2 0
  distortion buzz
  audf       40 55 70 85 100 115 130

instrument SNARE
  table      none
  volume     13 11 9 7 5 4 3 2 1 0
  distortion tone noise
  audf       50 8 9 10 11 12 13

instrument HAT
  table      none
  volume     8 5 3 1 0
  distortion noise
  audf       2

instrument OPEN
  table      none
  volume     8 7 6 5 4 3 2 2 1 1 0
  distortion noise
  audf       1

channel 1 drums DRUMS
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track INTRO K . H .  H . H .  S . H .  H . H .
  track INTRO2 K . H .  S . H .  K . S .  S S S S
  track A      K . H .  H . H .  S . H .  H . H .
  track A2     K . H .  S . H .  K . S .  S S S S
  track B      K . H .  S . H .  K . K .  S . H .
  track B2     S . S .  S . S .  S S S S  S S S S
  track BREAK  H H H H  H H H H  H H H H  H H H H
  track BUILD  K . H .  H . H .  S . H .  H . H .
  track BUILD2 S . S .  S . S .  S S S S  S S S S

channel 2 notes BASS
  note  Bass: roots, on the chords' roots.
  voice BASS
  track INTRO G2 . . .  . . . .  F2 . . .  . . . .
  track INTRO2 Eb1 . . .  . . . .  F1 . . .  . . . .
  track A      G2 . . .  G2 . . .  G2 . . .  F2 . . .
  track A2     Eb1 . . .  Eb1 . . .  Eb1 . . .  C1 . . .
  track A3     Bb1 . . .  Bb1 . . .  Bb1 . . .  G1 . . .
  track A4     F2 . . .  F2 . . .  F2 . . .  F2 . . .
  track B      Eb1 . Eb1 .  Eb1 . Eb1 .  Eb1 . Eb1 .  Eb1 . Eb1 .
  track B2     F1 . F2 .  F1 . F2 .  F1 . F2 .  F1 . Eb1 .
  track B3     D1 . D2 .  D1 . D2 .  D1 . D2 .  D1 . F1 .
  track B4     G1 . G2 .  G1 . G2 .  F1 . F2 .  F1 . F2 .
  track BUILD  G2 . G2 .  G2 . G2 .  G2 . G2 .  G2 . F2 .
  track BUILD2 Eb1 . Eb1 .  Eb1 . Eb1 .  F1 . F1 .  F1 . F1 .

channel 3 notes LEAD
  note  An example lead melody, written by Claude - not Greg's. The tracks are named M + the section's chord track.
  voice LEAD
  track MA D5 . . Bb4  . . G4 .  . . A4 .  Bb4 . . .
  track MA2 G4 . . .  . . Bb4 .  . . . .  G4 . Eb4 .
  track MA3 F4 . . D4  . . F4 .  . . Bb4 .  D5 . . .
  track MA4 C5 . . .  . . A4 .  . . . .  - . . .
  track MB  G5 . . F5  . . Eb5 .  . . Bb4 .  G4 . . .
  track MB2 F5 . . Eb5  . . C5 .  . . A4 .  F4 . . .
  track MB3 D5 . . C5  . . A4 .  . . F4 .  D4 . . .
  track MB4 G4 . . A4  . . Bb4 .  C5 . . .  . . - .
  track MBREAK D5 . . .  . . . .  . . . .  . . . .
  track MBREAK2 Eb5 . . .  . . . .  C5 . . .  . . - .
  track MBUILD  G4 . Bb4 .  D5 . G4 .  Bb4 . D5 .  G5 . . .
  track MBUILD2 G4 . Bb4 .  Eb5 . . .  F5 . C5 .  A4 . F4 .

channel 4 notes PATTERN
  note  Broken chord, up and back, on each chord.
  voice KEYS
  track INTRO G3 . Bb3 .  D4 . G4 .  Bb4 . G4 .  D4 . Bb3 .
  track INTRO2 Eb3 . G3 .  Bb3 . Eb4 .  A4 . F4 .  C4 . A3 .
  track A      G3 . Bb3 .  D4 . G4 .  Bb4 . G4 .  D4 . Bb3 .
  track A2     Eb3 . G3 .  Bb3 . Eb4 .  G4 . Eb4 .  Bb3 . G3 .
  track A3     Bb3 . D4 .  F4 . Bb4 .  D5 . Bb4 .  F4 . D4 .
  track A4     F3 . A3 .  C4 . F4 .  A4 . F4 .  C4 . A3 .
  track B      Eb3 . Bb3 .  G4 . Bb3 .  Eb3 . Bb3 .  G4 . Bb3 .
  track B2     F3 . C4 .  A4 . C4 .  F3 . C4 .  A4 . C4 .
  track B3     D4 . A4 .  F5 . A4 .  D4 . A4 .  F5 . A4 .
  track B4     G3 . D4 .  Bb4 . D4 .  F3 . C4 .  A4 . C4 .
  track BREAK  G3 . Bb3 .  D4 . G4 .  Bb4 . G4 .  D4 . Bb3 .
  track BREAK2 Eb3 . G3 .  Bb3 . Eb4 .  A4 . F4 .  C4 . A3 .
  track BUILD  G3 . Bb3 .  D4 . G4 .  Bb4 . G4 .  D4 . Bb3 .
  track BUILD2 Eb3 . G3 .  Bb3 . Eb4 .  A4 . F4 .  C4 . A3 .

# The order list: a section at a time.
speed  9
section INTRO
line   INTRO  INTRO  .  INTRO
line   INTRO2  INTRO2  .  INTRO2
section A
loop
line   A  A  MA A
line   A  A2  MA2  A2
line   A  A3  MA3  A3
line   A2  A4  MA4  A4
section B
line   B  B  MB B
line   B  B2  MB2  B2
line   B  B3  MB3  B3
line   B2  B4  MB4  B4
section BREAK
line   BREAK  .  MBREAK  BREAK
line   BREAK  .  MBREAK2  BREAK2
section BUILD
line   BUILD  BUILD  MBUILD  BUILD
line   BUILD2  BUILD2  MBUILD2  BUILD2
