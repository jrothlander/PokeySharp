# DRIFT NIGHT
# THIS COPY HAS A LEAD MELODY ON CHANNEL 3, WRITTEN BY CLAUDE AS AN EXAMPLE of what could go
# there. It is not Greg's writing. The accompaniment is the same as in songs/drift/.
# Night in the city: the minor vamp, an octave bass and a voice-led arpeggio over a
# half-time beat; the chorus picks up to a rock beat on the epic minor.
# DRIFT, a chill suite for one game: TITLE, CAFE, FIELD, RAIN, NIGHT, VICTORY, GAME OVER and
# CREDITS. All in B flat major or its relative G minor, laid-back, on one set of
# instruments. The title is New song's Chill style with its defaults, in B flat.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: i VII VI VII:  Gm F Eb F; in B, i VI III VII:  Gm Eb Bb F.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   DRIFT NIGHT
key    G MINOR

# Distortion C, for a bass. Its table skips notes - see which in the tracker's colours.
instrument BASS
  table      buzz
  volume     12 11 10 9 8
  distortion buzz
  release    3

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Soft keys for an accompaniment: struck, then falling away.
instrument KEYS
  table      tone
  volume     11 10 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    3

# Four drums: a falling thump, a burst of noise, and a short and a long hiss. Each is a
# table of registers a frame at a time, with no note table, so a key only says which drum.
instrument KICK
  table      none
  volume     15 13 10 7 4 2 0
  distortion buzz
  audf       40 55 70 85 100 115 130

instrument SNARE
  table      none
  volume     13 11 9 7 5 4 3 2 1 0
  distortion tone noise
  audf       50 8 9 10 11 12 13

instrument HAT
  table      none
  volume     8 5 3 1 0
  distortion noise
  audf       2

instrument OPEN
  table      none
  volume     8 7 6 5 4 3 2 2 1 1 0
  distortion noise
  audf       1

channel 1 drums DRUMS
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track INTRO K . H .  H . H .  S . H .  H . H .
  track INTRO2 K . H .  S . H .  K . S .  S S S S
  track A      K . H .  H . H .  S . H .  H . H .
  track A2     K . H .  S . H .  K . S .  S S S S
  track B      K . H .  S . H .  K . K .  S . H .
  track B2     S . S .  S . S .  S S S S  S S S S
  track BREAK  H H H H  H H H H  H H H H  H H H H
  track BUILD  K . H .  H . H .  S . H .  H . H .
  track BUILD2 S . S .  S . S .  S S S S  S S S S

channel 2 notes BASS
  note  Bass: octaves, on the chords' roots.
  voice BASS
  track INTRO G1 . . .  . . . .  G2 . . .  . . . .
  track INTRO2 F1 . . .  . . . .  D1 . . .  . . . .
  track A      G1 . . .  G2 . . .  G1 . . .  G2 . . .
  track A2     F1 . . .  F2 . . .  F1 . . .  F2 . . .
  track A3     Eb1 . . .  Eb1 . . .  Eb1 . . .  Eb1 . . .
  track A4     F1 . . .  Eb1 . . .  D1 . . .  F1 . . .
  track B      G1 . G2 .  G1 . G2 .  G1 . G2 .  G1 . F1 .
  track B2     Eb1 . Eb1 .  Eb1 . Eb1 .  Eb1 . Eb1 .  Eb1 . C1 .
  track B3     Bb1 . Bb1 .  Bb1 . Bb1 .  Bb1 . Bb1 .  Bb1 . G1 .
  track B4     F1 . F2 .  F1 . Eb1 .  D1 . D2 .  D1 . F1 .
  track BUILD  G1 . G2 .  G1 . G2 .  G1 . G2 .  G1 . G2 .
  track BUILD2 F1 . F2 .  F1 . Eb1 .  D1 . D2 .  D1 . F1 .

channel 3 notes LEAD
  note  An example lead melody, written by Claude - not Greg's. The tracks are named M + the section's chord track.
  voice LEAD
  track MA G4 . . Bb4  . . D5 .  . . C5 .  Bb4 . . .
  track MA2 A4 . . C5  . . F5 .  . . Eb5 .  C5 . . .
  track MA3 G4 . . Bb4  . . Eb5 .  . . D5 .  Bb4 . . .
  track MA4 A4 . . .  . . F4 .  D4 . . .  . . - .
  track MB  D5 . . D5  . . D5 .  . . C5 .  Bb4 . . .
  track MB2 Eb5 . . Eb5  . . Eb5 .  . . D5 .  Bb4 . . .
  track MB3 F5 . . F5  . . F5 .  . . Eb5 .  D5 . . .
  track MB4 C5 . . .  . . A4 .  D5 . . .  . . - .
  track MBREAK G4 . . .  . . . .  . . . .  . . . .
  track MBREAK2 A4 . . .  . . . .  F4 . . .  . . . .
  track MBUILD  G4 . G4 .  Bb4 . Bb4 .  D5 . D5 .  G5 . G5 .
  track MBUILD2 F5 . F5 .  C5 . C5 .  D5 . D5 .  A4 . A4 .

channel 4 notes CHORDS
  note  Arpeggio, up and down, on each chord.
  voice KEYS
  track INTRO G4 . Bb4 .  D5 . Bb4 .  G4 . Bb4 .  D5 . Bb4 .
  track INTRO2 F4 . A4 .  C5 . A4 .  F4 . A4 .  D5 . A4 .
  track A      G4 . Bb4 .  D5 . Bb4 .  G4 . Bb4 .  D5 . Bb4 .
  track A2     F4 . A4 .  C5 . A4 .  F4 . A4 .  C5 . A4 .
  track A3     Eb4 . G4 .  Bb4 . G4 .  Eb4 . G4 .  Bb4 . G4 .
  track A4     F4 . A4 .  C5 . A4 .  F4 . A4 .  D5 . A4 .
  track B      G4 . Bb4 .  D5 . G5 .  G4 . Bb4 .  D5 . G5 .
  track B2     G4 . Bb4 .  Eb5 . G5 .  G4 . Bb4 .  Eb5 . G5 .
  track B3     F4 . Bb4 .  D5 . F5 .  F4 . Bb4 .  D5 . F5 .
  track B4     F4 . A4 .  C5 . F5 .  F4 . A4 .  D5 . F5 .
  track BREAK  G4 . Bb4 .  D5 . Bb4 .  G4 . Bb4 .  D5 . Bb4 .
  track BREAK2 F4 . A4 .  C5 . A4 .  F4 . A4 .  D5 . A4 .
  track BUILD  G4 . Bb4 .  D5 . Bb4 .  G4 . Bb4 .  D5 . Bb4 .
  track BUILD2 F4 . A4 .  C5 . A4 .  F4 . A4 .  D5 . A4 .

# The order list: a section at a time.
speed  9
section INTRO
line   INTRO  INTRO  .  INTRO
line   INTRO2  INTRO2  .  INTRO2
section A
loop
line   A  A  MA A
line   A  A2  MA2  A2
line   A  A3  MA3  A3
line   A2  A4  MA4  A4
section B
line   B  B  MB B
line   B  B2  MB2  B2
line   B  B3  MB3  B3
line   B2  B4  MB4  B4
section BREAK
line   BREAK  .  MBREAK  BREAK
line   BREAK  .  MBREAK2  BREAK2
section BUILD
line   BUILD  BUILD  MBUILD  BUILD
line   BUILD2  BUILD2  MBUILD2  BUILD2
