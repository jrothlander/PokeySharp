# POWER BALLAD SKELETON
# A skeleton in the power-ballad form: verses that drop to almost nothing (no drums, one bass
# note a bar), a pre-chorus ramp, a full-band chorus; the quiet verse again; a bridge and a
# build; then the last choruses a whole step up (G to A) and an ending in the new key. Verse
# chords vi - IV - I - V, chorus I - V - vi - IV, slow. Form, chords, key and tempo are common
# property; nothing here is any song's melody. Channel 3 is empty for your tune - in the quiet
# verses, try short phrases with gaps, and answer each one: call and response.
#
# A starting point made by PokeyTracker's New song window, by rule: each section's beat, bass
# and accompaniment worked out from the key, the chords and the band chosen. The tune is yours.
# Chords: vi IV I V:  Em C G D; in B, I V vi IV:  G D Em C.
# The format is in Demo1/CLAUDE.md, under "Song files".

song   POWER BALLAD SKELETON
key    G MAJOR

# A soft, round bass: the pure tone, plucked and fading - no buzz, one channel, every note
# in tune from C3 up.
instrument SOFTBASS
  table      tone
  volume     12 11 10 9 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    2

# A plain square wave, for a tune.
instrument LEAD
  table      tone
  volume     12 11 10 10 9
  distortion tone
  release    2

# Soft keys for an accompaniment: struck, then falling away.
instrument KEYS
  table      tone
  volume     11 10 9 8 8 7 7 6 6 5 5 4
  distortion tone
  release    3

# Four drums: a falling thump, a burst of noise, and a short and a long hiss. Each is a
# table of registers a frame at a time, with no note table, so a key only says which drum.
instrument KICK
  table      none
  volume     15 13 10 7 4 2 0
  distortion buzz
  audf       40 55 70 85 100 115 130

instrument SNARE
  table      none
  volume     13 11 9 7 5 4 3 2 1 0
  distortion tone noise
  audf       50 8 9 10 11 12 13

instrument HAT
  table      none
  volume     8 5 3 1 0
  distortion noise
  audf       2

instrument OPEN
  table      none
  volume     8 7 6 5 4 3 2 2 1 1 0
  distortion noise
  audf       1

channel 1 drums DRUMS
  kit   K=KICK S=SNARE H=HAT O=OPEN
  track A     K . H .  S . H .  K . K .  S . H .
  track A2    K . H .  S . H .  K . S .  S S S S
  track PRE   K . . .  S . . .  K . . .  S . . .
  track PRE2  S . S .  S . S .  S S S S  S S S S
  track B     K . O .  K . O .  K . O .  K . O .
  track B2    S . S .  S . S .  S S S S  S S S S
  track BRIDGE K . H .  H . H .  S . H .  H . H .
  track BRIDGE2 K . H .  S . H .  S . S S  S S S S
  track BUILD   K . S S  K . S .  K . S S  K . S S
  track BUILD2  S . S .  S . S .  S S S S  S S S S
  track LIFT    K . O .  K . O .  K . O .  K . O .
  track LIFT2   S . S .  S . S .  S S S S  S S S S
  track ENDUP   O . . .  . . . .  . . . .  . . . .

channel 2 notes BASS
  note  Each section's own bass line, on the chords' roots.
  voice SOFTBASS
  track QUIET E3 . . .  . . . .  . . . .  . . . .
  track QUIET2 C3 . . .  . . . .  . . . .  . . . .
  track QUIET3 G3 . . .  . . . .  . . . .  . . . .
  track QUIET4 D3 . . .  . . . .  . . . .  . . . .
  track A      E3 . . .  B3 . . .  E3 . . .  D3 . . .
  track A2     C4 . . .  G4 . . .  C4 . . .  A3 . . .
  track A3     G3 . . .  D4 . . .  G3 . . .  E3 . . .
  track A4     D3 . . .  A3 . . .  D3 . . .  A3 . . .
  track PRE    E3 . E4 .  E3 . E4 .  E3 . E4 .  E3 . D3 .
  track PRE2   C3 . C4 .  C3 . C4 .  D3 . D4 .  D3 . D4 .
  track B      G3 . G4 .  G3 . G4 .  G3 . G4 .  G3 . E3 .
  track B2     D3 . D4 .  D3 . D4 .  D3 . D4 .  D3 . D4 .
  track B3     E3 . E4 .  E3 . E4 .  E3 . E4 .  E3 . D3 .
  track B4     C3 . C4 .  C3 . C4 .  D3 . D4 .  D3 . F#3 .
  track BRIDGE E3 . . .  . . . .  . . . .  . . . .
  track BRIDGE2 C3 . . .  . . . .  . . . .  . . . .
  track BUILD   E3 . E4 .  E3 . E4 .  E3 . E4 .  E3 . D3 .
  track BUILD2  C3 . C4 .  C3 . C4 .  D3 . D4 .  D3 . D4 .
  track LIFT    A3 . A4 .  A3 . A4 .  A3 . A4 .  A3 . F#3 .
  track LIFT2   E3 . E4 .  E3 . E4 .  E3 . E4 .  E3 . E4 .
  track LIFT3   F#3 . F#4 .  F#3 . F#4 .  F#3 . F#4 .  F#3 . E3 .
  track LIFT4   D3 . D4 .  D3 . D4 .  E3 . E4 .  E3 . G#3 .
  track ENDUP   A3 . . .  . . . .  . . . .  . . . .

channel 3 notes LEAD
  note  Empty: the tune is yours.
  voice LEAD
  track QUIET . . . .  . . . .  . . . .  . . . .
  track QUIET2 . . . .  . . . .  . . . .  . . . .
  track QUIET3 . . . .  . . . .  . . . .  . . . .
  track QUIET4 . . . .  . . . .  . . . .  . . . .
  track A      . . . .  . . . .  . . . .  . . . .
  track A2     . . . .  . . . .  . . . .  . . . .
  track A3     . . . .  . . . .  . . . .  . . . .
  track A4     . . . .  . . . .  . . . .  . . . .
  track PRE    . . . .  . . . .  . . . .  . . . .
  track PRE2   . . . .  . . . .  . . . .  . . . .
  track B      . . . .  . . . .  . . . .  . . . .
  track B2     . . . .  . . . .  . . . .  . . . .
  track B3     . . . .  . . . .  . . . .  . . . .
  track B4     . . . .  . . . .  . . . .  . . . .
  track BRIDGE . . . .  . . . .  . . . .  . . . .
  track BRIDGE2 . . . .  . . . .  . . . .  . . . .
  track BUILD   . . . .  . . . .  . . . .  . . . .
  track BUILD2  . . . .  . . . .  . . . .  . . . .
  track LIFT    . . . .  . . . .  . . . .  . . . .
  track LIFT2   . . . .  . . . .  . . . .  . . . .
  track LIFT3   . . . .  . . . .  . . . .  . . . .
  track LIFT4   . . . .  . . . .  . . . .  . . . .
  track ENDUP   . . . .  . . . .  . . . .  . . . .

channel 4 notes PATTERN
  note  Broken chord, up and back, on each chord.
  voice KEYS
  track QUIET E3 . G3 .  B3 . E4 .  G4 . E4 .  B3 . G3 .
  track QUIET2 C3 . E3 .  G3 . C4 .  E4 . C4 .  G3 . E3 .
  track QUIET3 G3 . B3 .  D4 . G4 .  B4 . G4 .  D4 . B3 .
  track QUIET4 D3 . F#3 .  A3 . D4 .  F#4 . D4 .  A3 . F#3 .
  track A      E3 . G3 .  B3 . E4 .  G4 . E4 .  B3 . G3 .
  track A2     C3 . E3 .  G3 . C4 .  E4 . C4 .  G3 . E3 .
  track A3     G3 . B3 .  D4 . G4 .  B4 . G4 .  D4 . B3 .
  track A4     D3 . F#3 .  A3 . D4 .  F#4 . D4 .  A3 . F#3 .
  track PRE    E3 . G3 .  B3 . E4 .  G4 . E4 .  B3 . G3 .
  track PRE2   C3 . E3 .  G3 . C4 .  F#4 . D4 .  A3 . F#3 .
  track B      G3 B3 D4 G4  B4 D5 G5 B5  G5 D5 B4 G4  D4 B3 G3 .
  track B2     D3 F#3 A3 D4  F#4 A4 D5 F#5  D5 A4 F#4 D4  A3 F#3 D3 .
  track B3     E3 G3 B3 E4  G4 B4 E5 G5  E5 B4 G4 E4  B3 G3 E3 .
  track B4     C3 E3 G3 C4  E4 G4 C5 E5  D5 A4 F#4 D4  A3 F#3 D3 .
  track BRIDGE E3 . G3 .  B3 . E4 .  G4 . E4 .  B3 . G3 .
  track BRIDGE2 C3 . E3 .  G3 . C4 .  F#4 . D4 .  A3 . F#3 .
  track BUILD   E3 . G3 .  B3 . E4 .  G4 . E4 .  B3 . G3 .
  track BUILD2  C3 . E3 .  G3 . C4 .  F#4 . D4 .  A3 . F#3 .
  track LIFT    A3 C#4 E4 A4  C#5 E5 A5 C#6  A5 E5 C#5 A4  E4 C#4 A3 .
  track LIFT2   E3 G#3 B3 E4  G#4 B4 E5 G#5  E5 B4 G#4 E4  B3 G#3 E3 .
  track LIFT3   F#3 A3 C#4 F#4  A4 C#5 F#5 A5  F#5 C#5 A4 F#4  C#4 A3 F#3 .
  track LIFT4   D3 F#3 A3 D4  F#4 A4 D5 F#5  E5 B4 G#4 E4  B3 G#3 E3 .
  track ENDUP   A3 . . .  . . . .  . . . .  . . . .

# The order list: a section at a time.
speed  13
section QUIET
line   .  QUIET  QUIET  QUIET
line   .  QUIET2  QUIET2  QUIET2
line   .  QUIET3  QUIET3  QUIET3
line   .  QUIET4  QUIET4  QUIET4
section A
line   A  A  A  A
line   A  A2  A2 A2
line   A  A3  A3 A3
line   A2  A4  A4 A4
section PRE
line   PRE  PRE  PRE  PRE
line   PRE2  PRE2  PRE2  PRE2
section B
line   B  B  B  B
line   B  B2  B2 B2
line   B  B3  B3 B3
line   B2  B4  B4 B4
section QUIET
line   .  QUIET  QUIET  QUIET
line   .  QUIET2  QUIET2  QUIET2
line   .  QUIET3  QUIET3  QUIET3
line   .  QUIET4  QUIET4  QUIET4
section PRE
line   PRE  PRE  PRE  PRE
line   PRE2  PRE2  PRE2  PRE2
section B
line   B  B  B  B
line   B  B2  B2 B2
line   B  B3  B3 B3
line   B2  B4  B4 B4
section BRIDGE
line   BRIDGE  BRIDGE  BRIDGE  BRIDGE
line   BRIDGE2  BRIDGE2  BRIDGE2  BRIDGE2
section BUILD
line   BUILD  BUILD  BUILD  BUILD
line   BUILD2  BUILD2  BUILD2  BUILD2
section LIFT
line   LIFT  LIFT  LIFT  LIFT
line   LIFT  LIFT2  LIFT2  LIFT2
line   LIFT  LIFT3  LIFT3  LIFT3
line   LIFT2  LIFT4  LIFT4  LIFT4
section LIFT
line   LIFT  LIFT  LIFT  LIFT
line   LIFT  LIFT2  LIFT2  LIFT2
line   LIFT  LIFT3  LIFT3  LIFT3
line   LIFT2  LIFT4  LIFT4  LIFT4
section ENDUP
line   ENDUP  ENDUP  ENDUP  ENDUP
end
